static void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef g = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();

    HAL_GPIO_WritePin(
        GPIOC, ONBOARD_LED_Pin, GPIO_PIN_SET);

    HAL_GPIO_WritePin(
        GPIOA,
        KEY_R1_Pin | KEY_R2_Pin |
        RFID_ENTRY_CS_Pin | RFID_EXIT_CS_Pin,
        GPIO_PIN_SET);

    HAL_GPIO_WritePin(
        GPIOA,
        RFID_ENTRY_RST_Pin | RFID_EXIT_RST_Pin,
        GPIO_PIN_RESET);

    HAL_GPIO_WritePin(
        GPIOB,
        DHT_11_Pin | KEY_R3_Pin | KEY_R4_Pin |
        FAN_RELAY_Pin | SPRINKLER_RELAY_Pin,
        GPIO_PIN_SET);

    HAL_GPIO_WritePin(
        GPIOB, BUZZER_Pin, GPIO_PIN_RESET);

    g.Pin = ONBOARD_LED_Pin;
    g.Mode = GPIO_MODE_OUTPUT_PP;
    g.Pull = GPIO_NOPULL;
    g.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOC, &g);

    g.Pin =
        RFID_ENTRY_CS_Pin | RFID_EXIT_CS_Pin |
        RFID_ENTRY_RST_Pin | RFID_EXIT_RST_Pin;
    g.Speed = GPIO_SPEED_FREQ_MEDIUM;
    HAL_GPIO_Init(GPIOA, &g);

    g.Pin =
        BUZZER_Pin | FAN_RELAY_Pin |
        SPRINKLER_RELAY_Pin;
    g.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOB, &g);

    g.Pin = KEY_R1_Pin | KEY_R2_Pin;
    g.Mode = GPIO_MODE_OUTPUT_OD;
    g.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(GPIOA, &g);

    g.Pin = KEY_R3_Pin | KEY_R4_Pin | DHT_11_Pin;
    HAL_GPIO_Init(GPIOB, &g);

    g.Pin =
        KEY_C1_Pin | KEY_C2_Pin |
        KEY_C3_Pin | KEY_C4_Pin;
    g.Mode = GPIO_MODE_INPUT;
    g.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(GPIOB, &g);

    /*
     * Flame ACTIVE LOW:
     * Use pull-up so a disconnected input defaults to no fire.
     */
    g.Pin = FLAME_D0_Pin;
    g.Pull =
        FLAME_ACTIVE_HIGH ?
        GPIO_PULLDOWN : GPIO_PULLUP;
    HAL_GPIO_Init(GPIOB, &g);

    g.Pin = IR_SENSOR_Pin;
    g.Pull =
        IR_ACTIVE_HIGH ?
        GPIO_PULLDOWN : GPIO_PULLUP;
    HAL_GPIO_Init(GPIOB, &g);

    HAL_NVIC_DisableIRQ(EXTI15_10_IRQn);

    __HAL_RCC_AFIO_CLK_ENABLE();
    __HAL_AFIO_REMAP_SWJ_NOJTAG();

    /* PA0 servo; PA5 SCK; PA7 MOSI. */
    g.Pin = GPIO_PIN_0 | GPIO_PIN_5 | GPIO_PIN_7;
    g.Mode = GPIO_MODE_AF_PP;
    g.Pull = GPIO_NOPULL;
    g.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOA, &g);

    /* PA6 MISO. */
    g.Pin = GPIO_PIN_6;
    g.Mode = GPIO_MODE_INPUT;
    g.Pull = GPIO_PULLDOWN;
    HAL_GPIO_Init(GPIOA, &g);

    /* PB6 SCL; PB7 SDA. */
    g.Pin = GPIO_PIN_6 | GPIO_PIN_7;
    g.Mode = GPIO_MODE_AF_OD;
    g.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(GPIOB, &g);
}

