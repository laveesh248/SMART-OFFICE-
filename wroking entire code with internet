/* ================================================================
   I2C DRIVER AND RECOVERY
   ================================================================ */

static bool bus_fault;
static uint32_t bus_failed_at;

static void bus_mark_fault(void)
{
    bus_fault = true;
    bus_failed_at = HAL_GetTick();
    g_devices.i2c_ready = 0;
}

static bool bus_available(void)
{
    if (bus_fault || !g_devices.i2c_ready) {
        return false;
    }

    if ((GPIOB->IDR & (GPIO_PIN_6 | GPIO_PIN_7)) !=
        (GPIO_PIN_6 | GPIO_PIN_7) ||
        __HAL_I2C_GET_FLAG(&hi2c1, I2C_FLAG_BUSY)) {
        bus_mark_fault();
        return false;
    }

    return true;
}

static bool bus_result(HAL_StatusTypeDef result)
{
    if (result == HAL_OK) {
        return true;
    }

    ++g_devices.i2c_errors;

    if (result != HAL_ERROR ||
        (HAL_I2C_GetError(&hi2c1) & ~HAL_I2C_ERROR_AF) != 0u ||
        __HAL_I2C_GET_FLAG(&hi2c1, I2C_FLAG_BUSY)) {
        bus_mark_fault();
    }

    return false;
}

static bool i2c_probe(uint8_t address)
{
    if (!bus_available()) {
        return false;
    }

    return bus_result(
        HAL_I2C_IsDeviceReady(
            &hi2c1, (uint16_t)address << 1, 1, 3));
}

static bool i2c_write(uint8_t address,
                      uint8_t *p, uint16_t size)
{
    if (!bus_available()) {
        return false;
    }

    return bus_result(
        HAL_I2C_Master_Transmit(
            &hi2c1, (uint16_t)address << 1, p, size, 4));
}

static bool rtc_read(uint8_t reg,
                     uint8_t *p, uint16_t size)
{
    if (!ENABLE_RTC || !bus_available()) {
        return false;
    }

    return bus_result(
        HAL_I2C_Mem_Read(
            &hi2c1, 0x68u << 1, reg,
            I2C_MEMADD_SIZE_8BIT, p, size, 4));
}

static bool rtc_write(uint8_t reg,
                      uint8_t *p, uint16_t size)
{
    if (!ENABLE_RTC || !bus_available()) {
        return false;
    }

    return bus_result(
        HAL_I2C_Mem_Write(
            &hi2c1, 0x68u << 1, reg,
            I2C_MEMADD_SIZE_8BIT, p, size, 4));
}

void I2C_Service(uint32_t now)
{
    if ((!ENABLE_LCD && !ENABLE_RTC) ||
        !g_devices.delay_timer_ready) {
        return;
    }

    if (!bus_fault && g_devices.i2c_ready) {
        return;
    }

    if (!expired(now, bus_failed_at, 1000)) {
        return;
    }

    bus_failed_at = now;
    HAL_I2C_DeInit(&hi2c1);

    GPIO_InitTypeDef g = {0};

    HAL_GPIO_WritePin(
        GPIOB, GPIO_PIN_6 | GPIO_PIN_7, GPIO_PIN_SET);

    g.Pin = GPIO_PIN_6 | GPIO_PIN_7;
    g.Mode = GPIO_MODE_OUTPUT_OD;
    g.Pull = GPIO_PULLUP;
    g.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOB, &g);

    for (unsigned i = 0;
         i < 9 && !(GPIOB->IDR & GPIO_PIN_7);
         ++i) {
        if (!(GPIOB->IDR & GPIO_PIN_6)) {
            break;
        }

        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_RESET);
        delay_us(5);
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_SET);
        delay_us(5);
    }

    HAL_GPIO_WritePin(
        GPIOB, GPIO_PIN_6 | GPIO_PIN_7, GPIO_PIN_RESET);
    delay_us(5);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, GPIO_PIN_SET);
    delay_us(5);

    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_7, GPIO_PIN_SET);
    delay_us(5);

    __HAL_RCC_I2C1_FORCE_RESET();
    __HAL_RCC_I2C1_RELEASE_RESET();

    g_devices.i2c_ready =
        HAL_I2C_Init(&hi2c1) == HAL_OK;

    bus_fault =
        !g_devices.i2c_ready ||
        (GPIOB->IDR & (GPIO_PIN_6 | GPIO_PIN_7)) !=
        (GPIO_PIN_6 | GPIO_PIN_7);

    if (bus_fault) {
        g_devices.i2c_ready = 0;
    }
}

/* ================================================================
   DS3231 RTC
   ================================================================ */

static bool bcd_valid(uint8_t v, uint8_t max)
{
    return (v & 15u) <= 9u &&
           (v >> 4) <= 9u &&
           ((v >> 4) * 10u + (v & 15u)) <= max;
}

static uint8_t from_bcd(uint8_t v)
{
    return (v >> 4) * 10u + (v & 15u);
}

static uint8_t to_bcd(uint8_t v)
{
    return (uint8_t)((v / 10u) << 4) | (v % 10u);
}

static uint8_t month_days(uint16_t year, uint8_t month)
{
    static const uint8_t days[12] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    if (month < 1 || month > 12) {
        return 0;
    }

    return days[month - 1] +
           (month == 2 && year % 4u == 0u);
}

bool RTC_ReadTime(ClockTime *t)
{
    uint8_t d[7], status;

    bool ok =
        rtc_read(0, d, 7) &&
        rtc_read(0x0F, &status, 1);

    g_devices.rtc_online = ok;
    g_devices.rtc_time_valid = 0;

    if (!ok ||
        (status & 0x80u) ||
        !bcd_valid(d[0], 59) ||
        !bcd_valid(d[1], 59)) {
        return false;
    }

    if (d[2] & 0x40u) {
        uint8_t h = d[2] & 0x1Fu;

        if (!bcd_valid(h, 12) || h == 0) {
            return false;
        }

        t->hour =
            from_bcd(h) % 12u +
            ((d[2] & 0x20u) ? 12u : 0u);
    } else {
        if (!bcd_valid(d[2], 23)) {
            return false;
        }

        t->hour = from_bcd(d[2]);
    }

    if ((d[5] & 0x80u) ||
        !bcd_valid(d[4], 31) ||
        !bcd_valid(d[5], 12) ||
        !bcd_valid(d[6], 99) ||
        d[3] < 1 || d[3] > 7) {
        return false;
    }

    uint8_t month = from_bcd(d[5]);
    uint8_t day = from_bcd(d[4]);

    if (month == 0 ||
        day == 0 ||
        day > month_days(
            2000u + from_bcd(d[6]), month)) {
        return false;
    }

    t->minute = from_bcd(d[1]);
    t->second = from_bcd(d[0]);

    g_devices.rtc_time_valid = 1;
    return true;
}

static void rtc_set_from_request(void)
{
    RTC_SetRequest r = g_rtc_set;
    g_rtc_set.request = 0;

    if (r.year < 2000 || r.year > 2099 ||
        r.month < 1 || r.month > 12 ||
        r.day < 1 ||
        r.day > month_days(r.year, r.month) ||
        r.weekday < 1 || r.weekday > 7 ||
        r.hour > 23 ||
        r.minute > 59 ||
        r.second > 59) {
        g_rtc_set.result = 2;
        return;
    }

    uint8_t d[7] = {
        to_bcd(r.second),
        to_bcd(r.minute),
        to_bcd(r.hour),
        r.weekday,
        to_bcd(r.day),
        to_bcd(r.month),
        to_bcd((uint8_t)(r.year - 2000))
    };

    uint8_t control, status;

    if (!rtc_read(0x0E, &control, 1) ||
        !rtc_write(0, d, 7)) {
        g_rtc_set.result = 3;
        return;
    }

    control &= (uint8_t)~0x80u;

    if (!rtc_write(0x0E, &control, 1) ||
        !rtc_read(0x0F, &status, 1)) {
        g_rtc_set.result = 3;
        return;
    }

    status &= (uint8_t)~0x80u;

    if (!rtc_write(0x0F, &status, 1)) {
        g_rtc_set.result = 3;
        return;
    }

    ClockTime t;
    g_rtc_set.result = RTC_ReadTime(&t) ? 1 : 3;
}

void RTC_Task(uint32_t now)
{
    static uint32_t last;

    if (!ENABLE_RTC) {
        return;
    }

    if (g_rtc_set.request == 0xA5u) {
        rtc_set_from_request();
    }

    if (expired(now, last, 2000)) {
        last = now;
        ClockTime t;
        (void)RTC_ReadTime(&t);
    }
}

/* ================================================================
   LCD DRIVER
   ================================================================ */

static char lcd_want[4][20], lcd_have[4][20];
static uint8_t lcd_phase, lcd_address, lcd_pos;
static uint32_t lcd_at;
static bool lcd_cursor_valid;

static const uint8_t lcd_row_address[4] = {
    0x00, 0x40, 0x14, 0x54
};

void LCD_SetLine(uint8_t row, const char *text)
{
    if (row > 3) {
        return;
    }

    unsigned i = 0;

    while (i < 20 && text[i]) {
        lcd_want[row][i] = text[i];
        ++i;
    }

    while (i < 20) {
        lcd_want[row][i++] = ' ';
    }
}

static bool lcd_nibble(uint8_t high)
{
    uint8_t b = high | LCD_BACKLIGHT;
    uint8_t p[3] = {b, (uint8_t)(b | LCD_EN), b};

    return i2c_write(lcd_address, p, 3);
}

static bool lcd_byte(uint8_t data, bool rs)
{
    uint8_t a =
        (data & 0xF0u) |
        LCD_BACKLIGHT |
        (rs ? LCD_RS : 0u);

    uint8_t b =
        (uint8_t)(data << 4) |
        LCD_BACKLIGHT |
        (rs ? LCD_RS : 0u);

    uint8_t p[6] = {
        a, (uint8_t)(a | LCD_EN), a,
        b, (uint8_t)(b | LCD_EN), b
    };

    return i2c_write(lcd_address, p, 6);
}

static void lcd_failed(uint32_t now)
{
    lcd_phase = 0;
    lcd_at = now;
    g_devices.lcd_online = 0;
    lcd_cursor_valid = false;
}

void LCD_Task(uint32_t now)
{
    if (!ENABLE_LCD) {
        return;
    }

    bool ok = true;

    if (lcd_phase == 0) {
        if (!expired(now, lcd_at, 1000)) {
            return;
        }

        lcd_at = now;

        if (LCD_ADDRESS) {
            lcd_address = LCD_ADDRESS;
        } else {
            lcd_address = 0x27;

            if (!i2c_probe(lcd_address)) {
                lcd_address = 0x3F;
            }
        }

        if (!i2c_probe(lcd_address)) {
            return;
        }

        g_devices.lcd_address = lcd_address;
        lcd_phase = 1;
        lcd_at = now;
        return;
    }

    if (lcd_phase < 9) {
        uint32_t wait =
            (lcd_phase == 1) ? 50u :
            ((lcd_phase == 2) ? 5u : 2u);

        if (!expired(now, lcd_at, wait)) {
            return;
        }

        switch (lcd_phase) {
        case 1:
        case 2:
        case 3:
            ok = lcd_nibble(0x30);
            break;

        case 4:
            ok = lcd_nibble(0x20);
            break;

        case 5:
            ok = lcd_byte(0x28, false);
            break;

        case 6:
            ok = lcd_byte(0x0C, false);
            break;

        case 7:
            ok = lcd_byte(0x01, false);
            break;

        case 8:
            ok = lcd_byte(0x06, false);
            break;

        default:
            break;
        }

        if (!ok) {
            lcd_failed(now);
            return;
        }

        lcd_at = now;
        ++lcd_phase;

        if (lcd_phase == 9) {
            memset(lcd_have, 0, sizeof(lcd_have));
            lcd_pos = 0;
            lcd_cursor_valid = false;
            g_devices.lcd_online = 1;
        }

        return;
    }

    for (unsigned n = 0; n < 80; ++n) {
        uint8_t row = lcd_pos / 20u;
        uint8_t col = lcd_pos % 20u;

        if (lcd_want[row][col] != lcd_have[row][col]) {
            if (!lcd_cursor_valid) {
                ok = lcd_byte(
                    0x80u | (lcd_row_address[row] + col),
                    false);
                lcd_cursor_valid = ok;
            } else {
                ok = lcd_byte(
                    (uint8_t)lcd_want[row][col], true);

                if (ok) {
                    lcd_have[row][col] = lcd_want[row][col];
                }

                lcd_cursor_valid = false;
                lcd_pos = (lcd_pos + 1u) % 80u;
            }

            if (!ok) {
                lcd_failed(now);
            }

            lcd_at = now;
            return;
        }

        lcd_cursor_valid = false;
        lcd_pos = (lcd_pos + 1u) % 80u;
    }

    if (expired(now, lcd_at, 2000)) {
        lcd_at = now;

        if (!i2c_probe(lcd_address)) {
            lcd_failed(now);
        }
    }
}

/* ================================================================
   KEYPAD DRIVER
   ================================================================ */

char Keypad_Task(uint32_t now)
{
    static const char map[4][4] = {
        {'1', '2', '3', 'A'},
        {'4', '5', '6', 'B'},
        {'7', '8', '9', 'C'},
        {'*', '0', '#', 'D'}
    };

    static GPIO_TypeDef *const ports[4] = {
        GPIOA, GPIOA, GPIOB, GPIOB
    };

    static const uint16_t rows[4] = {
        KEY_R1_Pin, KEY_R2_Pin,
        KEY_R3_Pin, KEY_R4_Pin
    };

    static const uint16_t cols[4] = {
        KEY_C1_Pin, KEY_C2_Pin,
        KEY_C3_Pin, KEY_C4_Pin
    };

    static uint32_t last, changed;
    static char candidate, stable;
    static bool blocked;

    if (!ENABLE_KEYPAD ||
        !g_devices.delay_timer_ready ||
        !expired(now, last, 5)) {
        return 0;
    }

    last = now;
    char found = 0;
    unsigned count = 0;

    for (unsigned r = 0; r < 4; ++r) {
        HAL_GPIO_WritePin(
            ports[r], rows[r], GPIO_PIN_RESET);
        delay_us(4);

        for (unsigned c = 0; c < 4; ++c) {
            if (!(GPIOB->IDR & cols[c])) {
                found = map[r][c];
                ++count;
            }
        }

        HAL_GPIO_WritePin(
            ports[r], rows[r], GPIO_PIN_SET);
    }

    if (count > 1) {
        blocked = true;
    }

    if (count == 0) {
        blocked = false;
    }

    if (blocked) {
        found = 0;
    }

    if (found != candidate) {
        candidate = found;
        changed = now;
    }

    if (expired(now, changed, 25) &&
        stable != candidate) {
        stable = candidate;

        if (stable) {
            g_devices.last_key = (uint8_t)stable;
            return stable;
        }
    }

    return 0;
}

/* ================================================================
   DHT11 DRIVER
   ================================================================ */

static uint8_t dht_phase;
static uint32_t dht_at;

static bool dht_wait_level(bool high, uint16_t timeout)
{
    uint16_t start = (uint16_t)TIM3->CNT;

    while (((GPIOB->IDR & DHT_11_Pin) != 0u) != high) {
        if ((uint16_t)((uint16_t)TIM3->CNT - start)
            >= timeout) {
            return false;
        }
    }

    return true;
}

static bool dht_capture(DHT_Result *out)
{
    uint8_t b[5] = {0};

    HAL_GPIO_WritePin(GPIOB, DHT_11_Pin, GPIO_PIN_SET);

    if (!dht_wait_level(true, 30) ||
        !dht_wait_level(false, 120) ||
        !dht_wait_level(true, 120) ||
        !dht_wait_level(false, 120)) {
        return false;
    }

    for (unsigned i = 0; i < 40; ++i) {
        if (!dht_wait_level(true, 90)) {
            return false;
        }

        uint16_t start = (uint16_t)TIM3->CNT;

        if (!dht_wait_level(false, 120)) {
            return false;
        }

        uint16_t pulse =
            (uint16_t)((uint16_t)TIM3->CNT - start);

        b[i / 8] =
            (uint8_t)((b[i / 8] << 1) | (pulse > 45u));
    }

    if ((uint8_t)(b[0] + b[1] + b[2] + b[3]) != b[4] ||
        b[0] > 100 ||
        b[1] > 9 ||
        b[2] > 50 ||
        (b[3] & 0x7Fu) > 9) {
        return false;
    }

    out->humidity10 =
        (uint16_t)(b[0] * 10u + b[1]);

    out->temperature10 =
        (int16_t)(b[2] * 10u + (b[3] & 0x7Fu));

    if (b[3] & 0x80u) {
        out->temperature10 = -out->temperature10;
    }

    return out->humidity10 <= 1000u;
}

bool DHT_Task(uint32_t now, DHT_Result *result)
{
    if (!ENABLE_DHT11 ||
        !g_devices.delay_timer_ready) {
        return false;
    }

    if (dht_phase == 0) {
        if (!expired(now, dht_at, DHT_SAMPLE_MS)) {
            return false;
        }

        HAL_GPIO_WritePin(
            GPIOB, DHT_11_Pin, GPIO_PIN_RESET);

        dht_at = now;
        dht_phase = 1;
        return false;
    }

    if (!expired(now, dht_at, 20)) {
        return false;
    }

    result->valid = dht_capture(result);

    HAL_GPIO_WritePin(
        GPIOB, DHT_11_Pin, GPIO_PIN_SET);

    dht_phase = 0;
    dht_at = HAL_GetTick();
    g_devices.dht_online = result->valid;

    if (!result->valid) {
        ++g_devices.dht_errors;
    }

    return true;
}

/* ================================================================
   TWO MFRC522 RFID READERS
   ================================================================ */

enum {
    R_COMMAND = 0x01,
    R_COMIRQ = 0x04,
    R_ERROR = 0x06,
    R_STATUS2 = 0x08,
    R_FIFO = 0x09,
    R_FIFOLEVEL = 0x0A,
    R_CONTROL = 0x0C,
    R_FRAMING = 0x0D,
    R_MODE = 0x11,
    R_TXMODE = 0x12,
    R_RXMODE = 0x13,
    R_TXCONTROL = 0x14,
    R_TXASK = 0x15,
    R_RFCFG = 0x26,
    R_TMODE = 0x2A,
    R_TPRESCALER = 0x2B,
    R_TRELOAD_H = 0x2C,
    R_TRELOAD_L = 0x2D,
    R_VERSION = 0x37
};

typedef enum {
    RF_OK,
    RF_ABSENT,
    RF_PROTOCOL,
    RF_IO
} RF_Result;

typedef struct {
    uint16_t cs, rst;
    uint8_t init_phase, misses;
    bool latched, io_ok;
    uint32_t at;
} Reader;

static Reader readers[2] = {
    {
        RFID_ENTRY_CS_Pin, RFID_ENTRY_RST_Pin,
        0, 0, false, true, 0
    },
    {
        RFID_EXIT_CS_Pin, RFID_EXIT_RST_Pin,
        0, 0, false, true, 0
    }
};

static int8_t rf_active = -1;
static uint8_t rf_next;
static uint32_t rf_field_at, rf_last;

typedef struct {
    uint8_t length;
    uint8_t uid[10];
} ApprovedCard;

/*
 * Used only when ACCEPT_ALL_CARDS is 0.
 * Example entry: {4, {0xDE, 0xAD, 0xBE, 0xEF}}
 */
static const ApprovedCard approved_cards[] = {
    {0, {0}}
};

static bool rf_enabled(unsigned i)
{
    return i == 0 ?
           ENABLE_ENTRY_RFID : ENABLE_EXIT_RFID;
}

static uint8_t rf_transfer(unsigned i,
                           uint8_t reg,
                           uint8_t value,
                           bool read)
{
    Reader *r = &readers[i];

    if (!r->io_ok) {
        return 0;
    }

    uint8_t tx[2] = {
        (uint8_t)(((reg << 1) & 0x7Eu) |
                  (read ? 0x80u : 0u)),
        value
    };

    uint8_t rx[2] = {0};

    HAL_GPIO_WritePin(
        GPIOA,
        RFID_ENTRY_CS_Pin | RFID_EXIT_CS_Pin,
        GPIO_PIN_SET);

    HAL_GPIO_WritePin(GPIOA, r->cs, GPIO_PIN_RESET);

    HAL_StatusTypeDef st =
        HAL_SPI_TransmitReceive(
            &hspi1, tx, rx, 2, 2);

    HAL_GPIO_WritePin(GPIOA, r->cs, GPIO_PIN_SET);

    if (st != HAL_OK) {
        ++g_devices.spi_errors;
        r->io_ok = false;
        HAL_SPI_Abort(&hspi1);
    }

    return rx[1];
}

static uint8_t rr(unsigned i, uint8_t reg)
{
    return rf_transfer(i, reg, 0, true);
}

static void rw(unsigned i, uint8_t reg, uint8_t value)
{
    (void)rf_transfer(i, reg, value, false);
}

static void rf_offline(unsigned i, uint32_t now)
{
    Reader *r = &readers[i];

    HAL_GPIO_WritePin(GPIOA, r->cs, GPIO_PIN_SET);
    HAL_GPIO_WritePin(GPIOA, r->rst, GPIO_PIN_RESET);

    r->init_phase = 0;
    r->at = now;
    g_devices.rfid_online[i] = 0;
}

static void rf_init_task(unsigned i, uint32_t now)
{
    Reader *r = &readers[i];

    if (!rf_enabled(i) ||
        !g_devices.spi_ready ||
        g_devices.rfid_online[i]) {
        return;
    }

    switch (r->init_phase) {
    case 0:
        if (!expired(now, r->at, 1000)) {
            return;
        }

        HAL_GPIO_WritePin(
            GPIOA, r->rst, GPIO_PIN_RESET);

        r->at = now;
        r->init_phase = 1;
        break;

    case 1:
        if (!expired(now, r->at, 2)) {
            return;
        }

        HAL_GPIO_WritePin(
            GPIOA, r->rst, GPIO_PIN_SET);

        r->at = now;
        r->init_phase = 2;
        break;

    default: {
        if (!expired(now, r->at, 50)) {
            return;
        }

        r->io_ok = true;

        uint8_t v = rr(i, R_VERSION);
        g_devices.rfid_version[i] = v;

        if (!r->io_ok ||
            (v != 0x90 && v != 0x91 &&
             v != 0x92 && v != 0x88)) {
            rf_offline(i, now);
            return;
        }

        rw(i, R_COMMAND, 0x00);
        rw(i, R_TXMODE, 0x00);
        rw(i, R_RXMODE, 0x00);
        rw(i, R_MODE, 0x3D);
        rw(i, R_TXASK, 0x40);
        rw(i, R_RFCFG, 0x70);

        rw(i, R_TMODE, 0x80);
        rw(i, R_TPRESCALER, 169);
        rw(i, R_TRELOAD_H, 0);
        rw(i, R_TRELOAD_L, 160);

        /* Antenna off until selected. */
        rw(i, R_TXCONTROL, 0x80);

        if (!r->io_ok || rr(i, R_TXASK) != 0x40) {
            rf_offline(i, now);
            return;
        }

        g_devices.rfid_online[i] = 1;
        break;
    }
    }
}

static void crc_a(const uint8_t *p,
                  uint8_t len,
                  uint8_t out[2])
{
    uint16_t crc = 0x6363;

    while (len--) {
        uint8_t b =
            (uint8_t)(*p++ ^ (uint8_t)crc);

        b ^= (uint8_t)(b << 4);

        crc = (uint16_t)(
            (crc >> 8) ^
            ((uint16_t)b << 8) ^
            ((uint16_t)b << 3) ^
            (b >> 4));
    }

    out[0] = (uint8_t)crc;
    out[1] = (uint8_t)(crc >> 8);
}

static RF_Result rf_exchange(
    unsigned i,
    const uint8_t *tx,
    uint8_t len,
    uint8_t bits,
    uint8_t *rx,
    uint8_t capacity,
    uint8_t *received)
{
    Reader *r = &readers[i];
    *received = 0;

    rw(i, R_COMMAND, 0);
    rw(i, R_COMIRQ, 0x7F);
    rw(i, R_FIFOLEVEL, 0x80);

    for (uint8_t n = 0; n < len; ++n) {
        rw(i, R_FIFO, tx[n]);
    }

    rw(i, R_FRAMING, bits);
    rw(i, R_COMMAND, 0x0C);
    rw(i, R_FRAMING, bits | 0x80u);

    uint32_t start = HAL_GetTick();
    uint8_t irq = 0;

    while (r->io_ok &&
           !expired(HAL_GetTick(), start, 7)) {
        irq = rr(i, R_COMIRQ);

        if (irq & 0x31u) {
            break;
        }

        Board_ServiceFast();
    }

    rw(i, R_FRAMING, bits);
    rw(i, R_COMMAND, 0);

    if (!r->io_ok) {
        return RF_IO;
    }

    if (!(irq & 0x30u)) {
        return RF_ABSENT;
    }

    if (rr(i, R_ERROR) & 0x1Bu) {
        return RF_PROTOCOL;
    }

    uint8_t count = rr(i, R_FIFOLEVEL);
    uint8_t last_bits = rr(i, R_CONTROL) & 7u;

    if (!r->io_ok) {
        return RF_IO;
    }

    if (count == 0 || count > capacity || last_bits) {
        return RF_PROTOCOL;
    }

    for (uint8_t n = 0; n < count; ++n) {
        rx[n] = rr(i, R_FIFO);
    }

    if (!r->io_ok) {
        return RF_IO;
    }

    *received = count;
    return RF_OK;
}

static RF_Result rf_read_uid(
    unsigned i,
    uint8_t uid[10],
    uint8_t *uid_len)
{
    uint8_t tx[9] = {0x52};
    uint8_t rx[10], n;

    *uid_len = 0;
    rw(i, R_STATUS2, 0);

    RF_Result result =
        rf_exchange(
            i, tx, 1, 7, rx, sizeof(rx), &n);

    if (result != RF_OK) {
        return result;
    }

    if (n != 2) {
        return RF_PROTOCOL;
    }

    for (uint8_t level = 0; level < 3; ++level) {
        tx[0] = (uint8_t)(0x93 + 2 * level);
        tx[1] = 0x20;

        result =
            rf_exchange(
                i, tx, 2, 0, rx, sizeof(rx), &n);

        if (result != RF_OK || n != 5) {
            return result == RF_IO ?
                   RF_IO : RF_PROTOCOL;
        }

        if ((uint8_t)(rx[0] ^ rx[1] ^
                      rx[2] ^ rx[3]) != rx[4]) {
            return RF_PROTOCOL;
        }

        bool cascade = rx[0] == 0x88;

        if (cascade && level == 2) {
            return RF_PROTOCOL;
        }

        uint8_t offset = cascade ? 1 : 0;

        for (uint8_t k = offset; k < 4; ++k) {
            uid[(*uid_len)++] = rx[k];
        }

        tx[1] = 0x70;
        memcpy(tx + 2, rx, 5);
        crc_a(tx, 7, tx + 7);

        result =
            rf_exchange(
                i, tx, 9, 0, rx, sizeof(rx), &n);

        if (result != RF_OK || n != 3) {
            return result == RF_IO ?
                   RF_IO : RF_PROTOCOL;
        }

        uint8_t crc[2];
        crc_a(rx, 1, crc);

        if (rx[1] != crc[0] ||
            rx[2] != crc[1] ||
            (((rx[0] & 4u) != 0u) != cascade)) {
            return RF_PROTOCOL;
        }

        if (!cascade) {
            tx[0] = 0x50;
            tx[1] = 0;
            crc_a(tx, 2, tx + 2);

            result =
                rf_exchange(
                    i, tx, 4, 0,
                    rx, sizeof(rx), &n);

            return result == RF_IO ?
                   RF_IO : RF_OK;
        }
    }

    return RF_PROTOCOL;
}

static bool approved(const uint8_t *uid, uint8_t len)
{
    if (ACCEPT_ALL_CARDS) {
        return true;
    }

    for (unsigned k = 0;
         k < sizeof(approved_cards) /
             sizeof(approved_cards[0]);
         ++k) {
        if (approved_cards[k].length == len &&
            memcmp(approved_cards[k].uid,
                   uid, len) == 0) {
            return true;
        }
    }

    return false;
}

int RFID_Task(uint32_t now)
{
    if (!ENABLE_ENTRY_RFID && !ENABLE_EXIT_RFID) {
        return -1;
    }

    if (rf_active < 0) {
        rf_init_task(0, now);
        rf_init_task(1, now);

        if (!expired(now, rf_last, 75)) {
            return -1;
        }

        rf_last = now;

        for (unsigned n = 0; n < 2; ++n) {
            unsigned i = rf_next;
            rf_next ^= 1u;

            if (!rf_enabled(i) ||
                !g_devices.rfid_online[i]) {
                continue;
            }

            readers[i].io_ok = true;

            uint8_t v = rr(i, R_VERSION);

            if (!readers[i].io_ok ||
                v != g_devices.rfid_version[i]) {
                rf_offline(i, now);
                continue;
            }

            rw(i, R_TXCONTROL, 0x83);

            if (!readers[i].io_ok) {
                rf_offline(i, now);
                continue;
            }

            rf_active = (int8_t)i;
            rf_field_at = now;
            break;
        }

        return -1;
    }

    if (!expired(now, rf_field_at, 6)) {
        return -1;
    }

    unsigned i = (unsigned)rf_active;
    Reader *r = &readers[i];

    uint8_t uid[10], len;

    RF_Result result = rf_read_uid(i, uid, &len);

    rw(i, R_TXCONTROL, 0x80);
    rf_active = -1;

    if (!r->io_ok || result == RF_IO) {
        rf_offline(i, HAL_GetTick());
        return -1;
    }

    if (result == RF_ABSENT) {
        if (r->misses < 3) {
            ++r->misses;
        }

        if (r->misses >= 3) {
            r->latched = false;
        }
    } else if (result == RF_OK) {
        r->misses = 0;
        g_devices.rfid_uid_len[i] = len;

        for (uint8_t k = 0; k < len; ++k) {
            g_devices.rfid_uid[i][k] = uid[k];
        }

        if (!r->latched) {
            r->latched = true;

            if (approved(uid, len)) {
                return (int)i;
            }

            ++g_devices.denied_count;
            return 2;
        }
    } else {
        r->misses = 0;
    }

    return -1;
}

void Devices_Init(void)
{
    memset(lcd_want, ' ', sizeof(lcd_want));
    memset(lcd_have, 0, sizeof(lcd_have));

    lcd_at = HAL_GetTick();
    dht_at = HAL_GetTick();

    for (unsigned i = 0; i < 2; ++i) {
        HAL_GPIO_WritePin(
            GPIOA, readers[i].cs, GPIO_PIN_SET);
        HAL_GPIO_WritePin(
            GPIOA, readers[i].rst, GPIO_PIN_RESET);

        readers[i].at = HAL_GetTick() - 1000u;
    }

    if (!g_devices.i2c_ready) {
        bus_mark_fault();
    }
}

