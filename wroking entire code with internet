static bool elapsed(uint32_t now,
                    uint32_t at,
                    uint32_t duration)
{
    return (uint32_t)(now - at) >= duration;
}

static void output(GPIO_TypeDef *port,
                    uint16_t pin,
                    bool active,
                    bool active_high)
{
    HAL_GPIO_WritePin(
        port, pin,
        (active == active_high) ?
        GPIO_PIN_SET : GPIO_PIN_RESET);
}

void Board_ServiceFast(void)
{
    if (!app_ready) {
        return;
    }

    uint32_t now = HAL_GetTick();

    bool flame =
        (GPIOB->IDR & FLAME_D0_Pin) != 0;
    bool ir =
        (GPIOB->IDR & IR_SENSOR_Pin) != 0;

    g_devices.flame_raw = flame;
    g_devices.ir_raw = ir;

    /*
     * With FLAME_ACTIVE_HIGH = 0:
     * flame LOW becomes fire = true.
     * flame HIGH becomes fire = false.
     */
    App_Step(
        &app, now,
        ENABLE_FLAME &&
        (flame == (FLAME_ACTIVE_HIGH != 0)),
        ENABLE_IR &&
        (ir == (IR_ACTIVE_HIGH != 0)));

    bool servo = app.servo_open;
    bool fan = app.fan_on;
    bool water = app.sprinkler_on;
    bool buzzer = app.buzzer_on;

    if (BENCH_TEST_MODE) {
        servo =
            BENCH_TEST_MODE == 1 &&
            (now / 3000u) % 2u;

        fan =
            BENCH_TEST_MODE == 2 &&
            (now / 2000u) % 2u;

        water =
            BENCH_TEST_MODE == 3 &&
            (now / 2000u) % 2u;

        buzzer =
            BENCH_TEST_MODE == 4 &&
            (now / 500u) % 2u;
    }

    g_devices.servo_command_open =
        ENABLE_SERVO && servo;

    g_devices.fan_command_on =
        ENABLE_FAN_RELAY && fan;

    g_devices.sprinkler_command_on =
        ENABLE_SPRINKLER_RELAY && water;

    g_devices.buzzer_command_on =
        ENABLE_BUZZER && buzzer;

    /* Both relays remain active LOW. */
    output(
        GPIOB, FAN_RELAY_Pin,
        g_devices.fan_command_on, false);

    output(
        GPIOB, SPRINKLER_RELAY_Pin,
        g_devices.sprinkler_command_on, false);

    /* Buzzer remains active HIGH. */
    output(
        GPIOB, BUZZER_Pin,
        g_devices.buzzer_command_on, true);

    if (g_devices.pwm_ready && ENABLE_SERVO) {
        __HAL_TIM_SET_COMPARE(
            &htim2, TIM_CHANNEL_1,
            servo ? SERVO_OPEN_US : SERVO_CLOSED_US);
    }

    output(
        GPIOC, ONBOARD_LED_Pin,
        (now / 500u) % 2u == 0u, false);

    g_devices.heartbeat = now;
}

static void clear_pin(void)
{
    pin_length = 0;
    pin_text[0] = '\0';
    pin_overflow = false;
}

static void grant_access(uint8_t side)
{
    uint32_t now = HAL_GetTick();

    App_GrantAccess(&app, now);
    Board_ServiceFast();

    access_side = side;
    ++g_devices.access_count[side];

    access_time_valid = RTC_ReadTime(&access_time);

    message = 1;
    message_at = now;
    clear_pin();
}

static void handle_key(char key, uint32_t now)
{
    if (!key) {
        return;
    }

    if (key == 'D') {
        diagnostics = !diagnostics;
        clear_pin();
        return;
    }

    if (diagnostics) {
        if (key == 'A') {
            diagnostic_page ^= 1u;
        }
        return;
    }

    pin_at = now;

    if (key == '*') {
        clear_pin();
        message = 0;
    } else if (key >= '0' && key <= '9') {
        message = 0;

        if (pin_length < 4) {
            pin_text[pin_length++] = key;
            pin_text[pin_length] = '\0';
        } else {
            pin_overflow = true;
        }
    } else if (key == '#') {
        if (!pin_overflow &&
            pin_length == 4 &&
            strcmp(pin_text, DOOR_PASSWORD) == 0) {
            grant_access(0);
        } else {
            message = 2;
            message_at = now;
            ++g_devices.denied_count;
            clear_pin();
        }
    }
}

static const char *status(bool enabled, bool online)
{
    return !enabled ?
           "OFF" : (online ? "OK" : "ERR");
}

static void update_display(uint32_t now)
{
    if (!elapsed(now, display_at, 100)) {
        return;
    }

    display_at = now;
    char line[32];

    if (BENCH_TEST_MODE) {
        LCD_SetLine(0, "OUTPUT BENCH TEST");

        snprintf(
            line, sizeof(line),
            "Mode:%u test active",
            (unsigned)BENCH_TEST_MODE);
        LCD_SetLine(1, line);

        snprintf(
            line, sizeof(line),
            "Servo:%u Fan:%u",
            g_devices.servo_command_open,
            g_devices.fan_command_on);
        LCD_SetLine(2, line);

        snprintf(
            line, sizeof(line),
            "Water:%u Buzzer:%u",
            g_devices.sprinkler_command_on,
            g_devices.buzzer_command_on);
        LCD_SetLine(3, line);
        return;
    }

    if (diagnostics) {
        if (diagnostic_page == 0) {
            snprintf(
                line, sizeof(line),
                "RF in:%s out:%s",
                status(
                    ENABLE_ENTRY_RFID,
                    g_devices.rfid_online[0]),
                status(
                    ENABLE_EXIT_RFID,
                    g_devices.rfid_online[1]));
            LCD_SetLine(0, line);

            snprintf(
                line, sizeof(line),
                "RTC:%s Time:%s",
                status(
                    ENABLE_RTC,
                    g_devices.rtc_online),
                g_devices.rtc_time_valid ? "OK" : "BAD");
            LCD_SetLine(1, line);

            snprintf(
                line, sizeof(line),
                "DHT:%s F:%u IR:%u",
                status(
                    ENABLE_DHT11,
                    g_devices.dht_online),
                g_devices.flame_raw,
                g_devices.ir_raw);
            LCD_SetLine(2, line);

            LCD_SetLine(3, "A:outputs D:return");
        } else {
            snprintf(
                line, sizeof(line),
                "Servo:%u PWM:%s",
                g_devices.servo_command_open,
                status(
                    ENABLE_SERVO,
                    g_devices.pwm_ready));
            LCD_SetLine(0, line);

            snprintf(
                line, sizeof(line),
                "Fan:%u Sprinkler:%u",
                g_devices.fan_command_on,
                g_devices.sprinkler_command_on);
            LCD_SetLine(1, line);

            snprintf(
                line, sizeof(line),
                "Buzz:%u Key:%c",
                g_devices.buzzer_command_on,
                g_devices.last_key ?
                g_devices.last_key : '-');
            LCD_SetLine(2, line);

            LCD_SetLine(3, "A:sensors D:return");
        }
        return;
    }

    if (pin_length || pin_overflow) {
        if (pin_overflow) {
            LCD_SetLine(0, "Too long: * clears");
        } else {
            snprintf(
                line, sizeof(line),
                "PIN: %s  # submit", pin_text);
            LCD_SetLine(0, line);
        }
    } else if (message == 1 &&
               !elapsed(now, message_at, DOOR_HOLD_MS)) {
        if (!elapsed(now, message_at, 1000)) {
            LCD_SetLine(0, "Access granted");
        } else if (access_time_valid) {
            snprintf(
                line, sizeof(line),
                "%s %02u:%02u:%02u",
                access_side ? "Exit" : "Entry",
                access_time.hour,
                access_time.minute,
                access_time.second);
            LCD_SetLine(0, line);
        } else if (!elapsed(now, message_at, 2000)) {
            LCD_SetLine(
                0, access_side ?
                "Exit accessed" : "Entry accessed");
        } else {
            LCD_SetLine(0, "Time unavailable");
        }
    } else if (message == 2 &&
               !elapsed(now, message_at, 2000)) {
        LCD_SetLine(0, "Wrong PIN");
    } else if (message == 3 &&
               !elapsed(now, message_at, 2000)) {
        LCD_SetLine(0, "Card not authorized");
    } else {
        LCD_SetLine(0, "Card or PIN, then #");
    }

    LCD_SetLine(
        1,
        !ENABLE_FLAME ? "Flame disabled" :
        (app.fire_detected ? "FIRE! EVACUATE!" :
         (app.fire_clearing ?
          "Fire clear: hold" : "No fire detected")));

    if (!ENABLE_DHT11) {
        LCD_SetLine(2, "DHT11 disabled");
    } else if (!app.dht_valid) {
        LCD_SetLine(
            2, now < 3000u ?
            "DHT11 starting..." : "DHT11 error");
    } else {
        int t = app.temperature10;
        unsigned magnitude =
            (unsigned)(t < 0 ? -t : t);

        snprintf(
            line, sizeof(line),
            "T:%s%u.%uC H:%u.%u%%",
            t < 0 ? "-" : "",
            magnitude / 10u,
            magnitude % 10u,
            app.humidity10 / 10u,
            app.humidity10 % 10u);
        LCD_SetLine(2, line);
    }

    LCD_SetLine(
        3,
        !ENABLE_IR ? "IR disabled" :
        (app.motion_visible ?
         "Motion detected" : "No motion detected"));
}

/* ================================================================
   MAIN
   ================================================================ */

int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_SPI1_Init();
    MX_TIM2_Init();
    MX_TIM3_Init();

    App_Init(&app);

    if (g_devices.delay_timer_ready) {
        g_devices.delay_timer_ready =
            HAL_TIM_Base_Start(&htim3) == HAL_OK;
    }

    if (g_devices.pwm_ready && ENABLE_SERVO) {
        g_devices.pwm_ready =
            HAL_TIM_PWM_Start(
                &htim2, TIM_CHANNEL_1) == HAL_OK;
    }

    __HAL_AFIO_REMAP_SWJ_NOJTAG();
    Devices_Init();

    app_ready = true;
    Board_ServiceFast();

    while (1) {
        uint32_t start = HAL_GetTick();

        Board_ServiceFast();

        DHT_Result result = {0};

        if (DHT_Task(HAL_GetTick(), &result)) {
            App_Temperature(
                &app,
                result.valid,
                result.temperature10,
                result.humidity10,
                HAL_GetTick());
        }

        Board_ServiceFast();

        handle_key(
            Keypad_Task(HAL_GetTick()),
            HAL_GetTick());

        if ((pin_length || pin_overflow) &&
            elapsed(HAL_GetTick(), pin_at, PIN_IDLE_MS)) {
            clear_pin();
        }

        Board_ServiceFast();

        int rf = RFID_Task(HAL_GetTick());

        if (rf == 0 || rf == 1) {
            grant_access((uint8_t)rf);
        } else if (rf == 2) {
            clear_pin();
            message = 3;
            message_at = HAL_GetTick();
        }

        Board_ServiceFast();

        I2C_Service(HAL_GetTick());
        RTC_Task(HAL_GetTick());

        Board_ServiceFast();

        update_display(HAL_GetTick());
        LCD_Task(HAL_GetTick());

        Board_ServiceFast();

        uint32_t duration = HAL_GetTick() - start;

        if (duration > g_devices.max_loop_ms) {
            g_devices.max_loop_ms = duration;
        }
    }
}

