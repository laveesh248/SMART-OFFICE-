/* ================= SETTINGS ================= */

#define TARGET_WIFI     "laveesha"

#define TEST_AP_NAME    "ESP01_TEST"
#define TEST_AP_PASS    "12345678"

#define LCD_RS          0x01U
#define LCD_EN          0x04U
#define LCD_BL          0x08U

/* ================= PERIPHERALS ================= */

I2C_HandleTypeDef hi2c1;
UART_HandleTypeDef huart1;

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
static void MX_USART1_UART_Init(void);

/* ================= TEST VARIABLES ================= */

static uint16_t lcd_address;

static unsigned int network_count;
static unsigned int client_count;

static uint8_t target_seen;
static uint32_t received_bytes;

/* Last response line, also available in the debugger. */
static char esp_line[256];

/* ================= LCD FUNCTIONS ================= */

/*
 * Standard PCF8574 backpack:
 * P0=RS, P1=RW, P2=EN, P3=Backlight, P4..P7=D4..D7.
 */

static void LCD_Write(uint8_t value)
{
    if (HAL_I2C_Master_Transmit(
            &hi2c1,
            lcd_address,
            &value,
            1,
            100) != HAL_OK)
    {
        Error_Handler();
    }
}

static void LCD_Nibble(uint8_t value, uint8_t rs)
{
    uint8_t data = (value & 0xF0U) | LCD_BL | rs;

    LCD_Write(data);
    LCD_Write(data | LCD_EN);
    HAL_Delay(1);
    LCD_Write(data);
    HAL_Delay(1);
}

static void LCD_Send(uint8_t value, uint8_t rs)
{
    LCD_Nibble(value, rs);
    LCD_Nibble((uint8_t)(value << 4), rs);
}

static void LCD_Command(uint8_t command)
{
    LCD_Send(command, 0);

    if (command == 0x01U || command == 0x02U)
    {
        HAL_Delay(3);
    }
}

static uint8_t LCD_Init(void)
{
    unsigned int address;
    uint8_t found = 0;

    for (address = 0x20; address <= 0x3F; address++)
    {
        if (address > 0x27 && address < 0x38)
        {
            continue;
        }

        if (HAL_I2C_IsDeviceReady(
                &hi2c1,
                (uint16_t)(address << 1),
                2,
                30) == HAL_OK)
        {
            lcd_address = (uint16_t)(address << 1);
            found = 1;
            break;
        }
    }

    if (!found)
    {
        return 0;
    }

    HAL_Delay(50);

    LCD_Nibble(0x30, 0);
    HAL_Delay(5);

    LCD_Nibble(0x30, 0);
    HAL_Delay(5);

    LCD_Nibble(0x30, 0);
    HAL_Delay(2);

    LCD_Nibble(0x20, 0);

    LCD_Command(0x28);
    LCD_Command(0x08);
    LCD_Command(0x01);
    LCD_Command(0x06);
    LCD_Command(0x0C);

    return 1;
}

static void LCD_Line(uint8_t row, const char *text)
{
    static const uint8_t row_address[4] =
    {
        0x00, 0x40, 0x14, 0x54
    };

    unsigned int column;
    uint8_t ended = 0;

    if (row >= 4)
    {
        return;
    }

    LCD_Command((uint8_t)(0x80U | row_address[row]));

    for (column = 0; column < 20; column++)
    {
        char c = ' ';

        if (!ended)
        {
            if (*text)
            {
                c = *text++;
            }
            else
            {
                ended = 1;
            }
        }

        LCD_Send((uint8_t)c, LCD_RS);
    }
}

/* ================= ESP RESPONSE PARSER ================= */

static void ESP_ParseLine(const char *line)
{
    const char *start;
    const char *end;
    const char *client_line;
    size_t length;

    unsigned int a, b, c, d;

    if (strncmp(line, "+CWLAP:", 7) == 0)
    {
        network_count++;

        /* The first quoted field is the network name. */
        start = strchr(line, '"');

        if (start)
        {
            start++;
            end = strchr(start, '"');

            if (end)
            {
                length = (size_t)(end - start);

                if (length == strlen(TARGET_WIFI) &&
                    strncmp(start, TARGET_WIFI, length) == 0)
                {
                    target_seen = 1;
                }
            }
        }
    }

    /*
     * AT+CWLIF formats vary:
     * +CWLIF:192.168.4.2,...
     * or 192.168.4.2,...
     */
    client_line = line;

    if (strncmp(line, "+CWLIF:", 7) == 0)
    {
        client_line = line + 7;
    }

    if (sscanf(client_line, "%u.%u.%u.%u",
               &a, &b, &c, &d) == 4)
    {
        if (a <= 255 && b <= 255 &&
            c <= 255 && d <= 255)
        {
            client_count++;
        }
    }
}

/*
 * Return values:
 *  1 = OK
 *  0 = Timeout
 * -1 = ESP ERROR / FAIL
 * -2 = UART transmit error
 * -3 = UART receive error
 */
static int ESP_Command(const char *command, uint32_t timeout)
{
    uint8_t byte;
    uint8_t overflow = 0;
    size_t used = 0;
    uint32_t start;
    HAL_StatusTypeDef status;

    received_bytes = 0;
    esp_line[0] = '\0';

    __HAL_UART_CLEAR_OREFLAG(&huart1);

    if (HAL_UART_Transmit(
            &huart1,
            (uint8_t *)command,
            (uint16_t)strlen(command),
            1000) != HAL_OK)
    {
        return -2;
    }

    start = HAL_GetTick();

    while ((uint32_t)(HAL_GetTick() - start) < timeout)
    {
        status = HAL_UART_Receive(
            &huart1, &byte, 1, 10);

        if (status == HAL_TIMEOUT)
        {
            continue;
        }

        if (status != HAL_OK)
        {
            return -3;
        }

        received_bytes++;

        if (byte == '\r')
        {
            continue;
        }

        if (byte == '\n')
        {
            esp_line[used] = '\0';

            if (!overflow)
            {
                ESP_ParseLine(esp_line);

                if (strcmp(esp_line, "OK") == 0)
                {
                    return 1;
                }

                if (strcmp(esp_line, "ERROR") == 0 ||
                    strcmp(esp_line, "FAIL") == 0)
                {
                    return -1;
                }
            }

            used = 0;
            overflow = 0;
            continue;
        }

        if (used < sizeof(esp_line) - 1U)
        {
            esp_line[used++] =
                byte == 0 ? '?' : (char)byte;
        }
        else
        {
            overflow = 1;
        }
    }

    esp_line[used] = '\0';
    return 0;
}

static void Stop_OnError(const char *stage, int result)
{
    LCD_Line(0, stage);

    if (result == -2)
    {
        LCD_Line(1, "UART transmit error");
    }
    else if (result == -3)
    {
        LCD_Line(1, "UART receive error");
    }
    else if (result == -1)
    {
        LCD_Line(1, "ESP returned ERROR");
    }
    else if (received_bytes == 0)
    {
        LCD_Line(1, "No UART bytes");
    }
    else
    {
        LCD_Line(1, "Response timed out");
    }

    LCD_Line(2, "Not proof of damage");
    LCD_Line(3, "Check power/firmware");

    while (1)
    {
        HAL_Delay(100);
    }
}

/* ================= MAIN ================= */

int main(void)
{
    int result;
    int scan_result;
    unsigned int attempt;

    char text[21];
    char command[128];

    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_USART1_UART_Init();

    /* This diagnostic uses polling, not RX interrupts. */
    HAL_NVIC_DisableIRQ(USART1_IRQn);
    HAL_UART_AbortReceive(&huart1);

    if (!LCD_Init())
    {
        while (1)
        {
            HAL_GPIO_TogglePin(led_GPIO_Port, led_Pin);
            HAL_Delay(300);
        }
    }

    LCD_Line(0, "ESP-01 Module Test");
    LCD_Line(1, "AT / Scan / AP");
    LCD_Line(2, "UART:115200");
    LCD_Line(3, "Starting...");
    HAL_Delay(3000);

    /* TEST 1: Check AT communication. */
    result = 0;

    for (attempt = 0; attempt < 3; attempt++)
    {
        result = ESP_Command("AT\r\n", 3000);

        if (result == 1)
        {
            break;
        }

        HAL_Delay(300);
    }

    if (result != 1)
    {
        Stop_OnError("AT test failed", result);
    }

    result = ESP_Command("ATE0\r\n", 3000);

    if (result != 1)
    {
        Stop_OnError("Echo setup failed", result);
    }

    /*
     * Enable both station and access-point operation.
     * This lets us scan and create a test network.
     */
    result = ESP_Command("AT+CWMODE=3\r\n", 5000);

    if (result != 1)
    {
        Stop_OnError("WiFi mode failed", result);
    }

    /* Stop a previous station connection, if present. */
    (void)ESP_Command("AT+CWQAP\r\n", 5000);

    /* TEST 2: Scan nearby Wi-Fi networks. */
    LCD_Line(0, "AT communication OK");
    LCD_Line(1, "Scanning WiFi...");
    LCD_Line(2, "Please wait");
    LCD_Line(3, "");

    network_count = 0;
    target_seen = 0;

    scan_result = ESP_Command("AT+CWLAP\r\n", 30000);

    LCD_Line(0, scan_result == 1
                ? "WiFi scan completed"
                : "WiFi scan failed");

    snprintf(text, sizeof(text),
             "Networks: %u", network_count);
    LCD_Line(1, text);

    LCD_Line(2, target_seen
                ? "laveesha FOUND"
                : "laveesha NOT FOUND");

    LCD_Line(3, "Next: own WiFi test");
    HAL_Delay(3000);

    /* TEST 3: Create the ESP's own Wi-Fi network. */
    LCD_Line(0, "Creating test WiFi");
    LCD_Line(1, TEST_AP_NAME);
    LCD_Line(2, "Password:12345678");
    LCD_Line(3, "Please wait");

    snprintf(
        command,
        sizeof(command),
        "AT+CWSAP=\"%s\",\"%s\",1,3\r\n",
        TEST_AP_NAME,
        TEST_AP_PASS);

    result = ESP_Command(command, 5000);

    if (result != 1)
    {
        Stop_OnError("AP setup failed", result);
    }

    /*
     * Query connected phones repeatedly.
     * Connect your phone to ESP01_TEST.
     *
     * Do not update the LCD during UART reception:
     * LCD writes are comparatively slow.
     */
    while (1)
    {
        client_count = 0;

        result = ESP_Command("AT+CWLIF\r\n", 3000);

        LCD_Line(0, "AT: OK  AP: Enabled");

        if (scan_result == 1)
        {
            snprintf(text, sizeof(text),
                     "Scan networks: %u", network_count);
            LCD_Line(1, text);
        }
        else
        {
            LCD_Line(1, "Scan command failed");
        }

        if (result != 1)
        {
            LCD_Line(2, "Client query failed");
            LCD_Line(3, "Check ESP firmware");
        }
        else if (client_count > 0)
        {
            LCD_Line(2, "Phone connected!");
            LCD_Line(3, "AP WiFi link works");
        }
        else
        {
            LCD_Line(2, "Join ESP01_TEST");
            LCD_Line(3, "Password:12345678");
        }

        HAL_Delay(3000);
    }
}

