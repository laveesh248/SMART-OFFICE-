static void MX_TIM3_Init(void);

static bool elapsed(uint32_t now,
                    uint32_t at,
                    uint32_t duration)
{
    return (uint32_t)(now - at) >= duration;
}

static void output(GPIO_TypeDef *port,
                    uint16_t pin,
                    bool active,
                    bool active_high)
{
    HAL_GPIO_WritePin(
        port, pin,
        (active == active_high) ?
        GPIO_PIN_SET : GPIO_PIN_RESET);
}

void Board_ServiceFast(void)
{
    if (!app_ready) {
        return;
    }

    uint32_t now = HAL_GetTick();

    bool flame =
        (GPIOB->IDR & FLAME_D0_Pin) != 0;
    bool ir =
        (GPIOB->IDR & IR_SENSOR_Pin) != 0;

    g_devices.flame_raw = flame;
    g_devices.ir_raw = ir;

    /*
     * With FLAME_ACTIVE_HIGH = 0:
     * flame LOW becomes fire = true.
     * flame HIGH becomes fire = false.
     */
    App_Step(
        &app, now,
        ENABLE_FLAME &&
        (flame == (FLAME_ACTIVE_HIGH != 0)),
        ENABLE_IR &&
        (ir == (IR_ACTIVE_HIGH != 0)));

    bool servo = app.servo_open;
    bool fan = app.fan_on;
    bool water = app.sprinkler_on;
    bool buzzer = app.buzzer_on;

    if (BENCH_TEST_MODE) {
        servo =
            BENCH_TEST_MODE == 1 &&
            (now / 3000u) % 2u;

        fan =
            BENCH_TEST_MODE == 2 &&
            (now / 2000u) % 2u;

        water =
            BENCH_TEST_MODE == 3 &&
            (now / 2000u) % 2u;

        buzzer =
            BENCH_TEST_MODE == 4 &&
            (now / 500u) % 2u;
    }

    g_devices.servo_command_open =
        ENABLE_SERVO && servo;

    g_devices.fan_command_on =
        ENABLE_FAN_RELAY && fan;

    g_devices.sprinkler_command_on =
        ENABLE_SPRINKLER_RELAY && water;

    g_devices.buzzer_command_on =
        ENABLE_BUZZER && buzzer;

    /* Both relays remain active LOW. */
    output(
        GPIOB, FAN_RELAY_Pin,
        g_devices.fan_command_on, false);

    output(
        GPIOB, SPRINKLER_RELAY_Pin,
        g_devices.sprinkler_command_on, false);

    /* Buzzer remains active HIGH. */
    output(
        GPIOB, BUZZER_Pin,
        g_devices.buzzer_command_on, true);

    if (g_devices.pwm_ready && ENABLE_SERVO) {
        __HAL_TIM_SET_COMPARE(
            &htim2, TIM_CHANNEL_1,
            servo ? SERVO_OPEN_US : SERVO_CLOSED_US);
    }

    output(
        GPIOC, ONBOARD_LED_Pin,
        (now / 500u) % 2u == 0u, false);

    g_devices.heartbeat = now;
}

static void clear_pin(void)
{
    pin_length = 0;
    pin_text[0] = '\0';
    pin_overflow = false;
}

static void grant_access(void)
{
    uint32_t now = HAL_GetTick();

    App_GrantAccess(&app, now);
    Board_ServiceFast();

    ++g_devices.access_count[0];

    message = 1;
    message_at = now;
    clear_pin();
}

static void handle_key(char key, uint32_t now)
{
    if (!key) {
        return;
    }

    if (key == 'D') {
        diagnostics = !diagnostics;
        clear_pin();
        return;
    }

    if (diagnostics) {
        if (key == 'A') {
            diagnostic_page ^= 1u;
        }
        return;
    }

    pin_at = now;

    if (key == '*') {
        clear_pin();
        message = 0;
    } else if (key >= '0' && key <= '9') {
        message = 0;

        if (pin_length < 4) {
            pin_text[pin_length++] = key;
            pin_text[pin_length] = '\0';
        } else {
            pin_overflow = true;
        }
    } else if (key == '#') {
        if (!pin_overflow &&
            pin_length == 4 &&
            strcmp(pin_text, DOOR_PASSWORD) == 0) {
            grant_access();
        } else {
            message = 2;
            message_at = now;
            ++g_devices.denied_count;
            clear_pin();
        }
    }
}

static const char *status(bool enabled, bool online)
{
    return !enabled ?
           "OFF" : (online ? "OK" : "ERR");
}

static void update_display(uint32_t now)
{
    if (!elapsed(now, display_at, 100)) {
        return;
    }

    display_at = now;
    char line[32];

    if (BENCH_TEST_MODE) {
        LCD_SetLine(0, "OUTPUT BENCH TEST");

        snprintf(
            line, sizeof(line),
            "Mode:%u test active",
            (unsigned)BENCH_TEST_MODE);
        LCD_SetLine(1, line);

        snprintf(
            line, sizeof(line),
            "Servo:%u Fan:%u",
            g_devices.servo_command_open,
            g_devices.fan_command_on);
        LCD_SetLine(2, line);

        snprintf(
            line, sizeof(line),
            "Water:%u Buzzer:%u",
            g_devices.sprinkler_command_on,
            g_devices.buzzer_command_on);
        LCD_SetLine(3, line);
        return;
    }

    if (diagnostics) {
        if (diagnostic_page == 0) {
            LCD_SetLine(0, "Keypad access active");
            LCD_SetLine(1, "LCD system active");

            snprintf(
                line, sizeof(line),
                "DHT:%s F:%u IR:%u",
                status(
                    ENABLE_DHT11,
                    g_devices.dht_online),
                g_devices.flame_raw,
                g_devices.ir_raw);
            LCD_SetLine(2, line);

            LCD_SetLine(3, "A:outputs D:return");
        } else {
            snprintf(
                line, sizeof(line),
                "Servo:%u PWM:%s",
                g_devices.servo_command_open,
                status(
                    ENABLE_SERVO,
                    g_devices.pwm_ready));
            LCD_SetLine(0, line);

            snprintf(
                line, sizeof(line),
                "Fan:%u Sprinkler:%u",
                g_devices.fan_command_on,
                g_devices.sprinkler_command_on);
            LCD_SetLine(1, line);

            snprintf(
                line, sizeof(line),
                "Buzz:%u Key:%c",
                g_devices.buzzer_command_on,
                g_devices.last_key ?
                g_devices.last_key : '-');
            LCD_SetLine(2, line);

            LCD_SetLine(3, "A:sensors D:return");
        }
        return;
    }

    if (pin_length || pin_overflow) {
        if (pin_overflow) {
            LCD_SetLine(0, "Too long: * clears");
        } else {
            snprintf(
                line, sizeof(line),
                "PIN: %s  # submit", pin_text);
            LCD_SetLine(0, line);
        }
    } else if (message == 1 &&
               !elapsed(now, message_at, DOOR_HOLD_MS)) {
        if (!elapsed(now, message_at, 1000)) {
            LCD_SetLine(0, "Access granted");
        } else {
            LCD_SetLine(0, "PIN access granted");
        }
    } else if (message == 2 &&
               !elapsed(now, message_at, 2000)) {
        LCD_SetLine(0, "Wrong PIN");
    } else {
        LCD_SetLine(0, "Enter PIN, then #");
    }

    LCD_SetLine(
        1,
        !ENABLE_FLAME ? "Flame disabled" :
        (app.fire_detected ? "FIRE! EVACUATE!" :
         (app.fire_clearing ?
          "Fire clear: hold" : "No fire detected")));

    if (!ENABLE_DHT11) {
        LCD_SetLine(2, "DHT11 disabled");
    } else if (!app.dht_valid) {
        LCD_SetLine(
            2, now < 3000u ?
            "DHT11 starting..." : "DHT11 error");
    } else {
        int t = app.temperature10;
        unsigned magnitude =
            (unsigned)(t < 0 ? -t : t);

        snprintf(
            line, sizeof(line),
            "T:%s%u.%uC H:%u.%u%%",
            t < 0 ? "-" : "",
            magnitude / 10u,
            magnitude % 10u,
            app.humidity10 / 10u,
            app.humidity10 % 10u);
        LCD_SetLine(2, line);
    }

    LCD_SetLine(
        3,
        !ENABLE_IR ? "IR disabled" :
        (app.motion_visible ?
         "Motion detected" : "No motion detected"));
}

