/* ================================================================
   APPLICATION LOGIC
   ================================================================ */

static bool logic_elapsed(uint32_t now,
                          uint32_t start,
                          uint32_t duration)
{
    return (uint32_t)(now - start) >= duration;
}

void App_Init(AppState *s)
{
    memset(s, 0, sizeof(*s));
    s->motion_armed = true;
}

void App_GrantAccess(AppState *s, uint32_t now)
{
    s->access_active = true;
    s->access_at = now;
    s->motion_active = false;
    s->motion_armed = false;
}

void App_Temperature(AppState *s, bool valid,
                     int16_t t, uint16_t h,
                     uint32_t now)
{
    s->dht_valid = valid;
    s->dht_at = now;

    if (!valid) {
        s->fan_on = false;
        s->fan_countdown = false;
        return;
    }

    s->temperature10 = t;
    s->humidity10 = h;

    if (!s->fan_on && t > FAN_ON_TENTHS) {
        s->fan_on = true;
    }

    if (s->fan_on) {
        if (t > FAN_OFF_TENTHS) {
            s->fan_countdown = false;
        } else if (!s->fan_countdown) {
            s->fan_countdown = true;
            s->fan_low_at = now;
        }
    }
}

void App_Step(AppState *s, uint32_t now,
              bool fire, bool motion)
{
    if (s->access_active &&
        logic_elapsed(now, s->access_at, DOOR_HOLD_MS)) {
        s->access_active = false;
    }

    s->fire_detected = fire;

    if (fire) {
        s->fire_hold = true;
        s->fire_clearing = false;
    } else if (s->fire_hold) {
        if (!s->fire_clearing) {
            s->fire_clearing = true;
            s->fire_clear_at = now;
        }

        if (logic_elapsed(now, s->fire_clear_at, FIRE_CLEAR_MS)) {
            s->fire_hold = false;
            s->fire_clearing = false;
        }
    }

    if (s->dht_valid &&
        logic_elapsed(now, s->dht_at, DHT_STALE_MS)) {
        s->dht_valid = false;
        s->fan_on = false;
        s->fan_countdown = false;
    }

    if (s->fan_countdown &&
        logic_elapsed(now, s->fan_low_at, FAN_RUN_ON_MS)) {
        s->fan_on = false;
        s->fan_countdown = false;
    }

    if (s->access_active || s->fire_hold) {
        s->motion_active = false;
        s->motion_armed = false;
    } else {
        if (s->motion_active &&
            logic_elapsed(now, s->motion_at, MOTION_ALERT_MS)) {
            s->motion_active = false;
        }

        if (!s->motion_active) {
            if (!motion) {
                s->motion_armed = true;
            } else if (s->motion_armed) {
                s->motion_armed = false;
                s->motion_active = true;
                s->motion_at = now;
            }
        }
    }

    s->motion_visible = motion || s->motion_active;
    s->servo_open = s->fire_hold || s->access_active;
    s->sprinkler_on = fire;

    s->buzzer_on =
        fire ||
        (s->motion_active &&
         (((uint32_t)(now - s->motion_at) /
           MOTION_HALF_PERIOD_MS) % 2u == 0u));
}

