int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_TIM2_Init();
    MX_TIM3_Init();

    App_Init(&app);

    if (g_devices.delay_timer_ready) {
        g_devices.delay_timer_ready =
            HAL_TIM_Base_Start(&htim3) == HAL_OK;
    }

    if (g_devices.pwm_ready && ENABLE_SERVO) {
        g_devices.pwm_ready =
            HAL_TIM_PWM_Start(
                &htim2, TIM_CHANNEL_1) == HAL_OK;
    }

    __HAL_AFIO_REMAP_SWJ_NOJTAG();
    Devices_Init();

    app_ready = true;
    Board_ServiceFast();

    while (1) {
        uint32_t start = HAL_GetTick();

        Board_ServiceFast();

        DHT_Result result = {0};

        if (DHT_Task(HAL_GetTick(), &result)) {
            App_Temperature(
                &app,
                result.valid,
                result.temperature10,
                result.humidity10,
                HAL_GetTick());
        }

        Board_ServiceFast();

        handle_key(
            Keypad_Task(HAL_GetTick()),
            HAL_GetTick());

        if ((pin_length || pin_overflow) &&
            elapsed(HAL_GetTick(), pin_at, PIN_IDLE_MS)) {
            clear_pin();
        }

        Board_ServiceFast();

        I2C_Service(HAL_GetTick());

        Board_ServiceFast();

        update_display(HAL_GetTick());
        LCD_Task(HAL_GetTick());

        Board_ServiceFast();

        uint32_t duration = HAL_GetTick() - start;

        if (duration > g_devices.max_loop_ms) {
            g_devices.max_loop_ms = duration;
        }
    }
}

