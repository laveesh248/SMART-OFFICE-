/* ESP-01 UART receiver: circular DMA, polled from the main loop.
   USART1 RX and DMA interrupts are not used. DMA1 Channel 5 is reserved
   for USART1_RX. Keep RX_SIZE a power of two. */

static volatile uint8_t rx_ring[RX_SIZE];
static uint16_t rx_tail;
static volatile uint8_t rx_fault;
static uint8_t rx_started;

static void uart_rx_start(void)
{
    __HAL_RCC_DMA1_CLK_ENABLE();

    /* TX uses blocking HAL_UART_Transmit(), so USART1 IRQ is unnecessary. */
    HAL_NVIC_DisableIRQ(USART1_IRQn);
    HAL_NVIC_DisableIRQ(DMA1_Channel5_IRQn);

    USART1->CR1 &= ~(USART_CR1_RXNEIE | USART_CR1_PEIE | USART_CR1_IDLEIE);
    USART1->CR3 &= ~(USART_CR3_EIE | USART_CR3_DMAR);

    DMA1_Channel5->CCR = 0;
    DMA1->IFCR = DMA_IFCR_CGIF5;
    __HAL_UART_CLEAR_OREFLAG(&huart1);
    __HAL_UART_CLEAR_FEFLAG(&huart1);
    __HAL_UART_CLEAR_NEFLAG(&huart1);
    __HAL_UART_CLEAR_PEFLAG(&huart1);

    DMA1_Channel5->CPAR = (uint32_t)(uintptr_t)&USART1->DR;
    DMA1_Channel5->CMAR = (uint32_t)(uintptr_t)rx_ring;
    DMA1_Channel5->CNDTR = RX_SIZE;
    DMA1_Channel5->CCR = DMA_CCR_MINC | DMA_CCR_CIRC | DMA_CCR_PL_1;
    DMA1_Channel5->CCR |= DMA_CCR_EN;
    USART1->CR3 |= USART_CR3_DMAR;

    rx_tail = 0;
    rx_started = 1;
}

typedef struct {
    char line[96];
    uint16_t used, total;
    uint8_t state, end;
    bool first;
    uint32_t at;
} Client;

static Client clients[CLIENTS];

static char at_line[160];
static char at_command[128];
static char buffer[CHUNK];

static unsigned at_used;
static uint32_t ipd_left, ipd_started;
static uint8_t ipd_id, flags;
static bool ip_seen;
volatile uint32_t wifi_restarts, wifi_rx_faults, wifi_health_failures;

enum {
    A_OK = 1,
    A_ERROR = 2,
    A_PROMPT = 4,
    A_SENT = 8,
    A_READY = 16,
    A_DOWN = 32
};

static int client = -1;
static uint8_t kind, phase;
static uint32_t offset, log_next, log_end;
static bool comma, reply_ok;
static const char *reply;

static void client_byte(Client *c, char x)
{
    if (c->state >= 2)
        return;

    if (!c->state) {
        memset(c, 0, sizeof *c);
        c->state = 1;
        c->first = true;
        c->at = ms();
    }

    if (++c->total > 4096) {
        c->line[0] = 0;
        c->state = 2;
        return;
    }

    if (c->first) {
        if (x == '\r' || x == '\n') {
            c->line[c->used] = 0;
            c->first = false;

        } else if (c->used < sizeof c->line - 1) {
            c->line[c->used++] = x;

        } else {
            c->line[0] = 0;
            c->state = 2;
            return;
        }
    }

    static const char end[] = "\r\n\r\n";

    if (x == end[c->end])
        c->end++;
    else
        c->end = x == '\r' ? 1 : 0;

    if (c->end == 4)
        c->state = 2;
}

static void at_received(void)
{
    if (!strcmp(at_line, "OK"))
        flags |= A_OK;

    if (!strcmp(at_line, "ERROR") ||
        !strcmp(at_line, "FAIL") ||
        strstr(at_line, "SEND FAIL") ||
        strstr(at_line, "busy"))
        flags |= A_ERROR;

    if (!strcmp(at_line, "SEND OK"))
        flags |= A_SENT;

    if (!strcmp(at_line, "ready"))
        flags |= A_READY;

    if (strstr(at_line, "WIFI DISCONNECT")) {
        flags |= A_DOWN;
        online = false;
        ip[0] = 0;
    }

    /* ESP-01 normally returns +CIFSR:STAIP,"a.b.c.d". Accept the STAIP
       field wherever it appears in the received response line. */
    char *p = strstr(at_line, "STAIP,");
    if (p) {
        p += 6;
        while (*p == ' ' || *p == '\"')
            p++;

        unsigned n = 0;
        while (p[n] && p[n] != '\"' && p[n] != ',' &&
               p[n] != ' ' && n < 15)
            n++;

        bool valid = n > 6 && n < 16;
        unsigned dots = 0;
        for (unsigned i = 0; i < n; i++) {
            if (p[i] == '.') dots++;
            else if (p[i] < '0' || p[i] > '9') valid = false;
        }
        if (dots != 3) valid = false;

        if (valid) {
            ip_seen = true;
            memcpy(ip, p, n);
            ip[n] = 0;
            if (!strcmp(ip, "0.0.0.0")) ip[0] = 0;
        }
    }

    if (at_line[0] >= '0' &&
        at_line[0] < '0' + CLIENTS &&
        at_line[1] == ',') {

        unsigned id = (unsigned)(at_line[0] - '0');

        if (!strcmp(at_line + 2, "CONNECT")) {
            memset(&clients[id], 0, sizeof clients[id]);
            clients[id].at = ms();
        }

        if (!strcmp(at_line + 2, "CLOSED"))
            clients[id].state = 0;
    }
}

static bool parse_uint(const char **s, uint32_t *v)
{
    const char *p = *s;
    *v = 0;

    if (*p < '0' || *p > '9')
        return false;

    while (*p >= '0' && *p <= '9') {
        if (*v > 6553 || (*v == 6553 && *p > '5'))
            return false;

        *v = *v * 10 + (unsigned)(*p++ - '0');
    }

    *s = p;
    return true;
}

static void uart_parse(void)
{
    unsigned budget = RX_SIZE;
    if (ipd_left && elapsed(ipd_started, 5000)) rx_fault = 1;
    uint16_t head;

    if (!rx_started)
        return;

    /* Recover a UART framing/noise/overrun indication without an RX ISR. */
    if (USART1->SR & (USART_SR_ORE | USART_SR_NE | USART_SR_FE | USART_SR_PE)) {
        volatile uint32_t discard = USART1->SR;
        discard = USART1->DR;
        (void)discard;
        rx_fault = 1;
    }

    if (DMA1->ISR & DMA_ISR_TEIF5) {
        DMA1->IFCR = DMA_IFCR_CTEIF5;
        rx_fault = 1;
    }

    head = (uint16_t)((RX_SIZE - DMA1_Channel5->CNDTR) & (RX_SIZE - 1U));
    while (rx_tail != head && budget--) {
        char c = (char)rx_ring[rx_tail];
        rx_tail = (uint16_t)((rx_tail + 1U) & (RX_SIZE - 1U));

        if (ipd_left) {
            if (ipd_id < CLIENTS)
                client_byte(&clients[ipd_id], c);

            ipd_left--;
            continue;
        }

        if (c == '>' && at_used == 0) {
            flags |= A_PROMPT;
            at_used = 0;
            continue;
        }

        /* Ignore the trailing space in the ESP prompt: '> '. */
        if (c == ' ' && at_used == 0)
            continue;

        if (c == '\r')
            continue;

        if (c == '\n') {
            at_line[at_used] = 0;
            at_received();
            at_used = 0;
            continue;
        }

        if (at_used < sizeof at_line - 1)
            at_line[at_used++] = c;
        else {
            rx_fault = 1;
            at_used = 0;
            return;
        }

        if (c == ':' &&
            at_used > 5 &&
            !memcmp(at_line, "+IPD,", 5)) {

            at_line[at_used] = 0;

            const char *p = at_line + 5;
            uint32_t id, len;

            if (parse_uint(&p, &id) &&
                *p++ == ',' &&
                parse_uint(&p, &len) &&
                *p == ':' &&
                id < CLIENTS) {

                ipd_id = (uint8_t)id;
                ipd_left = len;
                ipd_started = ms();

            } else {
                rx_fault = 1;
            }

            at_used = 0;
        }
    }
}

/* HTTP command handling */

static bool query(const char *path, const char *key,
                  char *outbuf, unsigned cap)
{
    const char *p = strchr(path, '?');

    if (!p)
        return false;

    p++;
    unsigned k = (unsigned)strlen(key);

    while (*p) {
        if (!strncmp(p, key, k) && p[k] == '=') {
            p += k + 1;

            unsigned n = 0;

            while (p[n] && p[n] != '&')
                n++;

            if (n >= cap)
                return false;

            memcpy(outbuf, p, n);
            outbuf[n] = 0;
            return true;
        }

        p = strchr(p, '&');

        if (!p)
            break;

        p++;
    }

    return false;
}

static void execute(const char *path)
{
    char x[24], v[20];

    reply_ok = false;
    reply = "Invalid command";

    if (!query(path, "x", x, sizeof x))
        return;

    v[0] = 0;
    (void)query(path, "v", v, sizeof v);

    safety_task();

    if (!strcmp(x, "entry")) {
        access(3, 2, 0);

    } else if (!strcmp(x, "open")) {
        if (fire) {
            reply = "Fire already holds door open";
            log_event(3, 2, 6, 0);
            return;
        }

        hold = true;
        log_event(3, 2, 2, 0);
        say("Door: Held Open", false);

    } else if (!strcmp(x, "close")) {
        if (fire || ir_detected) {
            reply = fire ? "Blocked by fire alarm" : "IR exit is occupied";
            log_event(3, 2, 6, 0);
            return;
        }

        hold = false;
        timed = false;
        log_event(3, 2, 3, 0);
        say("Door: Closed", false);

    } else if (!strcmp(x, "fan_on")) {
        if (fire) {
            reply = "Fan blocked by fire";
            return;
        }

        fan_mode = 1;

    } else if (!strcmp(x, "fan_off")) {
        fan_mode = 2;

    } else if (!strcmp(x, "fan_auto")) {
        fan_mode = 0;

    } else if (!strcmp(x, "motion_on")) {
        motion_mode = 1;

    } else if (!strcmp(x, "motion_off")) {
        motion_mode = 2;
        motion = false;
        locked = false;

    } else if (!strcmp(x, "motion_auto")) {
        motion_mode = 0;

    } else if (!strcmp(x, "schedule")) {
        if (!digits(v, 8))
            return;

        unsigned a = pair(v);
        unsigned b = pair(v + 2);
        unsigned c = pair(v + 4);
        unsigned d = pair(v + 6);

        if (a > 23 || c > 23 ||
            b > 59 || d > 59 ||
            a * 60 + b == c * 60 + d) {

            reply = "Choose different valid hours";
            return;
        }

        start_min = (uint16_t)(a * 60 + b);
        end_min = (uint16_t)(c * 60 + d);

    } else if (!strcmp(x, "clock")) {
        if (!set_clock(v)) {
            reply = "Invalid time or RTC unavailable";
            return;
        }

    } else {
        return;
    }

    safety_task();

    reply_ok = true;
    reply = "Command applied";
}

static void http_begin(unsigned id)
{
    Client *c = &clients[id];

    c->state = 3;
    client = (int)id;
    phase = 0;
    offset = 0;
    kind = 3;
    reply_ok = false;
    reply = "Unknown request";

    bool get = !strncmp(c->line, "GET ", 4);
    bool post = !strncmp(c->line, "POST ", 5);

    char *p = strchr(c->line, ' ');

    if (!p)
        return;

    p++;

    char *e = strchr(p, ' ');

    if (!e)
        return;

    *e = 0;

    if (get && !strcmp(p, "/")) {
        kind = 0;

    } else if (get && !strcmp(p, "/status")) {
        kind = 1;

    } else if (get && !strcmp(p, "/events")) {
        kind = 2;
        log_end = sequence;

        log_next = sequence >= EVENT_COUNT
                 ? sequence - EVENT_COUNT + 1 : 1;

        comma = false;

    } else if (post && !strncmp(p, "/cmd?", 5)) {
        execute(p);
    }
}

static unsigned http_chunk(const uint8_t **data)
{
    *data = (const uint8_t *)buffer;

    Text t = text(buffer, sizeof buffer);

    if (!phase) {
        phase = 1;

        put(&t, "HTTP/1.0 200 OK\r\nContent-Type: ");
        put(&t, kind ? "application/json"
                     : "text/html; charset=utf-8");

        put(&t,
            "\r\nCache-Control: no-store\r\n"
            "Connection: close\r\n\r\n");

        return t.n;
    }

    if (phase == 2)
        return 0;

    if (kind == 0) {
        unsigned n = (unsigned)(sizeof page - 1 - offset);

        if (n > CHUNK)
            n = CHUNK;

        *data = (const uint8_t *)page + offset;
        offset += n;

        if (!n)
            phase = 2;

        return n;
    }

    if (kind == 1) {
        phase = 2;

        put(&t, "{\"up\":");
        num(&t, ms() / 1000);

        put(&t, ",\"seq\":");
        num(&t, sequence);

        put(&t, ",\"ip\":");
        quoted(&t, ip);

        put(&t, ",\"door\":");
        quoted(&t, door_status());

        put(&t, ",\"ir\":");
        num(&t, ir_detected);

        put(&t, ",\"fire\":");
        num(&t, fire);

        put(&t, ",\"t\":");
        if (dht_ok)
            num(&t, temp10);
        else
            put(&t, "null");

        put(&t, ",\"h\":");
        if (dht_ok)
            num(&t, hum10);
        else
            put(&t, "null");

        put(&t, ",\"motion\":");
        quoted(&t, motion_status());

        put(&t, ",\"mm\":");
        num(&t, motion_mode);

        put(&t, ",\"clock\":\"");
        if (clock_good())
            date_put(&t, date);
        else
            put(&t, "Clock unavailable");

        put(&t, "\",\"start\":");
        num(&t, start_min);

        put(&t, ",\"end\":");
        num(&t, end_min);

        ch(&t, '}');
        return t.n;
    }

    if (kind == 3) {
        phase = 2;

        put(&t, "{\"ok\":");
        put(&t, reply_ok ? "true" : "false");

        put(&t, ",\"message\":");
        quoted(&t, reply);
        ch(&t, '}');

        return t.n;
    }

    if (!offset) {
        ch(&t, '[');
        offset = 1;
    }

    while (log_next <= log_end &&
           sizeof buffer - t.n > 128) {

        Event e = events[(log_next - 1) % EVENT_COUNT];
        log_next++;

        if (e.seq != log_next - 1)
            continue;

        if (comma)
            ch(&t, ',');

        comma = true;

        ch(&t, '[');
        num(&t, e.seq);

        put(&t, ",\"");
        if (e.valid)
            date_put(&t, e.date);

        put(&t, "\",");
        num(&t, e.who);

        ch(&t, ',');
        num(&t, e.method);

        ch(&t, ',');
        num(&t, e.result);

        put(&t, ",\"");
        if (e.uid)
            hex8(&t, e.uid);

        put(&t, "\",");
        num(&t, e.valid);

        ch(&t, ',');
        num(&t, e.up);

        ch(&t, ']');
    }

    if (log_next > log_end) {
        ch(&t, ']');
        phase = 2;
    }

    return t.n;
}

/* Non-blocking ESP8266 AT state machine */

enum {
    W_BACKOFF,
    W_RESET,
    W_SETUP,
    W_IDLE,
    W_PROMPT,
    W_SENT,
    W_CLOSE,
    W_PING
};

static uint8_t wifi_state, setup_step;
static bool at_wait;
static uint8_t health_misses, ip_tries;
static uint32_t deadline = 1500, ping_at;

static const uint8_t *send_data;
static unsigned send_len;

static bool at_send(const char *s, uint32_t timeout)
{
    unsigned n = (unsigned)strlen(s);

    if (n >= sizeof at_command)
        return false;

    uart_parse();
    if (rx_fault) return false;
    memcpy(at_command, s, n + 1U);
    /* Preserve asynchronous notifications across command boundaries. */
    flags &= A_READY | A_DOWN;
    if (!strcmp(s, "AT+CIFSR\r\n")) ip_seen = false;

    /* Blocking TX matches the reference design and removes the need for
       USART1 TX interrupts. DMA continues collecting ESP-01 replies. */
    if (HAL_UART_Transmit(&huart1, (uint8_t *)at_command,
                          (uint16_t)n, 1000U) != HAL_OK)
        return false;

    deadline = ms() + timeout;
    return true;
}

static void restart(void)
{
    (void)HAL_UART_AbortTransmit(&huart1);

    wifi_restarts++;
    online = false;
    ip[0] = 0;
    wifi_state = W_BACKOFF;
    /* Short backoff after a confirmed disconnect or command failure. */
    deadline = ms() + 2500U;

    at_wait = false;
    flags = 0;
    at_used = 0;
    ipd_left = 0;
    client = -1;

    memset(clients, 0, sizeof clients);
}

static bool client_command(bool sending)
{
    char b[40];
    Text t = text(b, sizeof b);

    put(&t, sending ? "AT+CIPSEND=" : "AT+CIPCLOSE=");
    num(&t, (unsigned)client);

    if (sending) {
        ch(&t, ',');
        num(&t, send_len);
    }

    put(&t, "\r\n");

    return at_send(b, sending ? 3000 : 2000);
}

static void wifi_task(void)
{
    static const char *const setup[] = {
        "ATE0\r\n",
        "AT+CWMODE=1\r\n",
        "AT+CWDHCP=1,1\r\n",
        "AT+CWJAP=\"" WIFI_SSID "\",\"" WIFI_PASSWORD "\"\r\n",
        "AT+CIPMODE=0\r\n",
        "AT+CIPMUX=1\r\n",
        "AT+CIPSERVER=0\r\n",
        "AT+CIPDINFO=0\r\n",
        "AT+CIPRECVMODE=0\r\n",
        "AT+CIPSERVER=1,80\r\n",
        "AT+CIPSTO=10\r\n",
        "AT+CIFSR\r\n"
    };

    uart_parse();

    if (rx_fault) {
        /* A parser/DMA receive fault is not proof that Wi-Fi disconnected.
           Restart RX bookkeeping only; let the current AT command timeout
           decide whether the ESP actually stopped responding. This avoids
           resetting the ESP-01 for a single malformed/partial UART frame. */
        wifi_rx_faults++;
        rx_fault = 0;
        uart_rx_start();
        at_used = 0;
        ipd_left = 0;
        flags &= (A_READY | A_DOWN);
        /* Drop only incomplete HTTP requests; do not clear the Wi-Fi state. */
        for (unsigned i = 0; i < CLIENTS; i++) {
            if (clients[i].state == 1)
                memset(&clients[i], 0, sizeof clients[i]);
        }
        return;
    }

    if ((wifi_state != W_BACKOFF &&
         wifi_state != W_RESET &&
         (flags & A_READY)) ||
        (wifi_state >= W_IDLE && (flags & A_DOWN))) {

        restart();
        return;
    }

    if (wifi_state == W_BACKOFF) {
        if (due(deadline)) {
            if (at_send("AT+RST\r\n", 8000)) {
                wifi_state = W_RESET;
            } else {
                /* Keep the backoff state and retry; do not spin-reset. */
                deadline = ms() + 1000U;
            }
        }

        return;
    }

    if (wifi_state == W_RESET) {
        if ((flags & A_READY) &&
            huart1.gState == HAL_UART_STATE_READY) {

            wifi_state = W_SETUP;
            setup_step = 0;
            ip_tries = 0;
            health_misses = 0;
            at_wait = false;
            flags = 0;

        } else if (due(deadline)) {
            /* Some ESP-01 AT builds omit 'ready' or emit it before DMA is
               fully armed. Probe/configure instead of entering a reset loop. */
            wifi_state = W_SETUP;
            setup_step = 0;
            ip_tries = 0;
            health_misses = 0;
            at_wait = false;
            flags = 0;
        }

        return;
    }

    if (wifi_state == W_SETUP) {
        if (!at_wait) {
            at_wait = at_send(
                setup[setup_step], setup_step == 3 ? 45000 : 3000);
            return;
        }

        bool optional =
            setup_step == 6 ||
            setup_step == 8 ||
            setup_step == 10;

        if ((flags & A_OK) || (optional && (flags & A_ERROR))) {
            at_wait = false;
            flags = 0;

            if (++setup_step == sizeof setup / sizeof setup[0]) {
                if (!ip_seen || !ip[0]) {
                    if (++ip_tries >= 5) { restart(); return; }
                    /* Retry only CIFSR; do not repeatedly reset/rejoin Wi-Fi
                       just because the first IP response was missed. */
                    setup_step = (sizeof setup / sizeof setup[0]) - 1;
                    return;
                }

                online = true;
                wifi_state = W_IDLE;
                ping_at = ms() + 30000;
            }

        } else if ((flags & A_ERROR) || due(deadline)) {
            restart();
        }

        return;
    }

    if (wifi_state == W_IDLE) {
        if (huart1.gState != HAL_UART_STATE_READY)
            return;

        if (client < 0) {
            for (unsigned i = 0; i < CLIENTS; i++) {
                if (clients[i].state == 1 &&
                    elapsed(clients[i].at, 5000)) {

                    clients[i].line[0] = 0;
                    clients[i].state = 2;
                }

                if (clients[i].state == 2) {
                    http_begin(i);
                    break;
                }
            }
        }

        if (client >= 0) {
            if (!clients[client].state) {
                client = -1;
                return;
            }

            send_len = http_chunk(&send_data);

            if (client_command(send_len != 0)) {
                wifi_state = send_len ? W_PROMPT : W_CLOSE;
            } else {
                restart();
            }

        } else if (due(ping_at)) {
            if (at_send("AT+CIFSR\r\n", 3000))
                wifi_state = W_PING;
        }

        return;
    }

    if (wifi_state == W_PROMPT && (flags & A_PROMPT)) {
        flags = 0;

        if (HAL_UART_Transmit(&huart1, (uint8_t *)send_data,
                              (uint16_t)send_len, 500U) == HAL_OK) {
            wifi_state = W_SENT;
            deadline = ms() + 5000U;
        } else {
            restart();
        }

        return;
    }

    if (wifi_state == W_SENT && (flags & A_SENT)) {

        flags = 0;
        wifi_state = W_IDLE;
        return;
    }

    if (wifi_state == W_CLOSE &&
        ((flags & (A_OK | A_ERROR)) || due(deadline))) {

        if (client >= 0)
            memset(&clients[client], 0, sizeof(Client));

        client = -1;
        flags = 0;
        wifi_state = W_IDLE;
        return;
    }

    if (wifi_state == W_PING &&
        ((flags & (A_OK | A_ERROR)) || due(deadline))) {
        if ((flags & A_OK) && ip_seen && ip[0]) {
            health_misses = 0;
        } else {
            wifi_health_failures++;
            if (++health_misses >= 3) { restart(); return; }
        }
        flags = 0;
        ping_at = ms() + (health_misses ? 5000U : 30000U);
        wifi_state = W_IDLE;
        return;
    }

    if ((wifi_state == W_PROMPT || wifi_state == W_SENT) &&
        (flags & A_ERROR)) {

        if (client_command(false))
            wifi_state = W_CLOSE;
        else if (due(deadline))
            restart();

        return;
    }

    if ((flags & A_ERROR) || due(deadline))
        restart();
}

