static bool clock_good(void)
{
    return rtc_ok && !elapsed(rtc_at, 2500);
}

static void date_put(Text *t, Date d)
{
    put(t, "20");
    two(t, d.y);
    ch(t, '-');
    two(t, d.mo);
    ch(t, '-');
    two(t, d.d);
    ch(t, ' ');
    two(t, d.h);
    ch(t, ':');
    two(t, d.m);
    ch(t, ':');
    two(t, d.s);
}

static void log_event(uint8_t who, uint8_t method,
                      uint8_t result, uint32_t uid)
{
    Event *e = &events[sequence % EVENT_COUNT];

    e->seq = ++sequence;
    e->up = ms() / 1000;
    e->uid = uid;
    e->date = date;
    e->who = who;
    e->method = method;
    e->result = result;
    e->valid = clock_good();
}

static void say(const char *s, bool ok)
{
    Text t = text(message, sizeof message);

    put(&t, s);
    message_at = ms();
    granted = ok;
}

static void access(uint8_t who, uint8_t method, uint32_t uid)
{
    log_event(who, method, who ? 0 : 1, uid);

    if (!who) {
        say("Access Denied", false);
        return;
    }

    say(who == 1 ? "Welcome Employee 1"
                 : who == 2 ? "Welcome Employee 2"
                            : "Welcome",
        true);

    if (!fire && !hold) {
        timed = true;
        door_until = ms() + 5000;
    }
}

static bool monitoring(void)
{
    if (!pir_ready)
        return false;

    if (motion_mode)
        return motion_mode == 1;

    if (!clock_good())
        return false;

    unsigned m = date.h * 60U + date.m;

    return start_min > end_min
        ? (m >= start_min || m < end_min)
        : (m >= start_min && m < end_min);
}

static const char *motion_status(void)
{
    if (!pir_ready)
        return "Warming Up";

    if (motion)
        return "Detected!";

    if (motion_mode == 2)
        return "OFF";

    if (!motion_mode && !clock_good())
        return "Clock Error";

    return monitoring() ? "Armed" : "Scheduled";
}

static const char *door_status(void)
{
    return fire ? "Emergency Open"
         : ir_detected ? "IR Exit Open"
         : hold ? "Held Open"
         : door ? "Timed Access"
                : "Closed";
}

void HAL_GPIO_EXTI_Callback(uint16_t p)
{
    if (p == FLAME_PIN && flame_input()) {
        fire_latch = 1;

        out(GPIOB, WATER_PIN, false);
        out(GPIOB, FAN_PIN, true);
        out(GPIOB, BUZZER_PIN, true);

        TIM2->CCR1 = SERVO_OPEN_US;
    }
}

/* Polling and debounce need no interrupt, delay, timer channel or DMA.
 * One event per detection; stable clear rearms the next exit request.
 */
static void ir_exit_task(void)
{
    static bool candidate, warmed;
    static uint32_t changed_at;
    bool detected = IR_ACTIVE_LOW
                  ? !high(GPIOA, IR_EXIT_PIN) : high(GPIOA, IR_EXIT_PIN);

    if (!warmed && !elapsed(boot_at, 500)) {
        candidate = detected;
        changed_at = ms();
        return;
    }
    warmed = true;
    if (detected != candidate) {
        candidate = detected;
        changed_at = ms();
    }
    if (candidate == ir_detected ||
        !elapsed(changed_at, candidate ? IR_DETECT_MS : IR_CLEAR_MS))
        return;

    ir_detected = candidate;
    if (ir_detected) {
        log_event(4, 5, 0, 0);
        say("Exit Access Granted", true);
        timed = true;
        door_until = ms() + 5000;
    }
}

static void safety_task(void)
{
    uint32_t n = ms();
    ir_exit_task();

    uint32_t mask = __get_PRIMASK();
    __disable_irq();

    bool detected = fire_latch || flame_input();
    fire_latch = 0;

    __set_PRIMASK(mask);

    if (detected) {
        if (!fire) {
            fire = true;
            log_event(4, 3, 4, 0);
        }

        fire_wait = false;

    } else if (fire) {
        if (!fire_wait) {
            fire_wait = true;
            fire_low_at = n;
        }

        if (elapsed(fire_low_at, 2000)) {
            fire = false;
            fire_wait = false;
            hold = false;
            timed = false;

            log_event(4, 3, 5, 0);
        }
    }

    if (dht_ok && elapsed(dht_at, 6000))
        dht_ok = false;

    if (fire) {
        fan = false;
        fan_wait = false;

    } else if (fan_mode) {
        fan = fan_mode == 1;
        fan_wait = false;

    } else if (!dht_ok) {
        fan = false;
        fan_wait = false;

    } else if (temp10 > 330) {
        fan = true;
        fan_wait = false;

    } else if (temp10 == 330) {
        fan_wait = false;

    } else if (fan) {
        if (!fan_wait) {
            fan_wait = true;
            fan_low_at = n;
        }

        if (elapsed(fan_low_at, 10000)) {
            fan = false;
            fan_wait = false;
        }
    }

    if (!pir_ready && elapsed(boot_at, PIR_WARMUP_MS))
        pir_ready = true;

    bool pir = high(GPIOB, PIR_PIN);

    if (locked && elapsed(alarm_at, 10000)) {
        motion = false;
        locked = false;
    }

    if (motion_mode == 2) {
        motion = false;
        locked = false;
    }

    if (!locked && !pir)
        pir_armed = true;

    if (monitoring() && !locked && pir && pir_armed) {
        motion = true;
        locked = true;
        pir_armed = false;
        alarm_at = n;

        log_event(4, 4, 4, 0);
    }

    if (timed && due(door_until))
        timed = false;

    door = fire || ir_detected || hold || timed;

    mask = __get_PRIMASK();
    __disable_irq();

    bool emergency = fire || fire_latch || flame_input();

    TIM2->CCR1 = emergency || door
               ? SERVO_OPEN_US : SERVO_CLOSED_US;

    out(GPIOB, WATER_PIN, !emergency);
    out(GPIOB, FAN_PIN, emergency || !fan);

    out(GPIOB, BUZZER_PIN,
        emergency || (motion && ((n - alarm_at) / 250) % 2 == 0));

    __set_PRIMASK(mask);
}

/* DHT11 */

static bool wait_level(bool v, uint16_t limit)
{
    uint16_t t = (uint16_t)TIM3->CNT;

    while (high(GPIOB, DHT_PIN) != v) {
        if ((uint16_t)((uint16_t)TIM3->CNT - t) >= limit)
            return false;
    }

    return true;
}

static void dht_task(void)
{
    static bool started;
    static uint32_t next = 2000, at;

    if (!started) {
        if (!due(next))
            return;

        gpio(GPIOB, DHT_PIN, GPIO_MODE_OUTPUT_OD, GPIO_PULLUP);
        out(GPIOB, DHT_PIN, false);

        at = ms();
        started = true;
        return;
    }

    if (!elapsed(at, 20))
        return;

    uint8_t b[5] = {0};
    bool ok = true;

    out(GPIOB, DHT_PIN, true);
    gpio(GPIOB, DHT_PIN, GPIO_MODE_INPUT, GPIO_PULLUP);

    if (!wait_level(false, 120) ||
        !wait_level(true, 120) ||
        !wait_level(false, 120))
        ok = false;

    for (unsigned i = 0; i < 40 && ok; i++) {
        if (!wait_level(true, 100)) {
            ok = false;
            break;
        }

        uint16_t t = (uint16_t)TIM3->CNT;

        if (!wait_level(false, 120)) {
            ok = false;
            break;
        }

        b[i / 8] = (uint8_t)(
            (b[i / 8] << 1) |
            ((uint16_t)((uint16_t)TIM3->CNT - t) > 48));
    }

    ok = ok &&
         (uint8_t)(b[0] + b[1] + b[2] + b[3]) == b[4] &&
         b[0] <= 100 &&
         b[2] <= 80 &&
         b[1] <= 9 &&
         b[3] <= 9;

    dht_ok = ok;

    if (ok) {
        hum10 = b[0] * 10U + b[1];
        temp10 = b[2] * 10U + b[3];
        dht_at = ms();
    }

    started = false;
    next = ms() + 2000;
}

/* Shared LCD / RTC I2C bus */

static bool bus_ready(void)
{
    if (bus_bad)
        return false;

    /*
     * HAL may return after setting STOP but before STOP completes.
     * Allow the hardware to settle instead of treating that as a fault.
     */
    uint16_t t = (uint16_t)TIM3->CNT;

    for (;;) {
        if (!(I2C1->CR1 & I2C_CR1_STOP) &&
            !(I2C1->SR2 & I2C_SR2_BUSY) &&
            high(GPIOB, GPIO_PIN_6) &&
            high(GPIOB, GPIO_PIN_7)) {

            us(5);
            return true;
        }

        if ((uint16_t)((uint16_t)TIM3->CNT - t) >= 1000) {
            bus_bad = true;
            return false;
        }
    }
}

static bool bus_result(HAL_StatusTypeDef s)
{
    uint32_t error = HAL_I2C_GetError(&hi2c1);

    if (s == HAL_TIMEOUT ||
        s == HAL_BUSY ||
        (error & (HAL_I2C_ERROR_BERR |
                  HAL_I2C_ERROR_ARLO |
                  HAL_I2C_ERROR_OVR |
                  HAL_I2C_ERROR_TIMEOUT))) {
        bus_bad = true;
    }

    /* An absent device's address NACK alone is not a bus fault. */
    bool idle = bus_ready();

    return s == HAL_OK && idle;
}

static bool iwrite(uint8_t a, uint8_t *b, uint16_t n)
{
    return bus_ready() &&
           bus_result(HAL_I2C_Master_Transmit(
               &hi2c1, (uint16_t)a << 1, b, n, 4));
}

static bool rtc_io(bool write, uint8_t reg,
                   uint8_t *b, uint8_t n)
{
    if (!bus_ready())
        return false;

    return bus_result(
        write
            ? HAL_I2C_Mem_Write(
                &hi2c1, 0xD0, reg, I2C_MEMADD_SIZE_8BIT, b, n, 4)
            : HAL_I2C_Mem_Read(
                &hi2c1, 0xD0, reg, I2C_MEMADD_SIZE_8BIT, b, n, 4));
}

static bool bus_pin(uint16_t p, bool level)
{
    uint16_t t = (uint16_t)TIM3->CNT;

    while (high(GPIOB, p) != level) {
        if ((uint16_t)((uint16_t)TIM3->CNT - t) >= 500)
            return false;
    }

    us(5);
    return true;
}

static void bus_task(void)
{
    static uint32_t next;

    if (!bus_bad || !due(next))
        return;

    next = ms() + 1000;

    lcd_restart = true;
    rtc_ok = false;

    __HAL_I2C_DISABLE(&hi2c1);

    out(GPIOB, GPIO_PIN_6 | GPIO_PIN_7, true);

    gpio(GPIOB, GPIO_PIN_6 | GPIO_PIN_7,
         GPIO_MODE_OUTPUT_OD, GPIO_NOPULL);

    bool ok = bus_pin(GPIO_PIN_6, true);

    /* Release a slave that may be waiting for remaining clocks. */
    for (unsigned i = 0;
         i < 9 && ok && !high(GPIOB, GPIO_PIN_7);
         i++) {

        out(GPIOB, GPIO_PIN_6, false);
        us(5);

        out(GPIOB, GPIO_PIN_6, true);
        ok = bus_pin(GPIO_PIN_6, true);
    }

    if (ok)
        ok = bus_pin(GPIO_PIN_7, true);

    /*
     * STM32F1 filter-unlock sequence:
     * SDA low, SCL low, SCL high, SDA high.
     */
    if (ok) {
        out(GPIOB, GPIO_PIN_7, false);
        ok = bus_pin(GPIO_PIN_7, false);
    }

    if (ok) {
        out(GPIOB, GPIO_PIN_6, false);
        ok = bus_pin(GPIO_PIN_6, false);
    }

    if (ok) {
        out(GPIOB, GPIO_PIN_6, true);
        ok = bus_pin(GPIO_PIN_6, true);
    }

    out(GPIOB, GPIO_PIN_6 | GPIO_PIN_7, true);

    if (ok)
        ok = bus_pin(GPIO_PIN_7, true);

    gpio(GPIOB, GPIO_PIN_6 | GPIO_PIN_7,
         GPIO_MODE_AF_OD, GPIO_NOPULL);

    SET_BIT(I2C1->CR1, I2C_CR1_SWRST);
    us(5);
    CLEAR_BIT(I2C1->CR1, I2C_CR1_SWRST);

    hi2c1.State = HAL_I2C_STATE_RESET;
    hi2c1.Lock = HAL_UNLOCKED;

    HAL_StatusTypeDef s = HAL_I2C_Init(&hi2c1);

    bus_bad = !ok || s != HAL_OK;

    if (!bus_bad)
        (void)bus_ready();
}

/* DS3231 */

static uint8_t bcd(unsigned v)
{
    return (uint8_t)(v / 10 * 16 + v % 10);
}

static uint8_t dec(uint8_t v)
{
    return (uint8_t)((v >> 4) * 10 + (v & 15));
}

static unsigned month_days(unsigned y, unsigned m)
{
    static const uint8_t d[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    return d[m - 1] + (m == 2 && y % 4 == 0);
}

static bool date_valid(Date d)
{
    return d.y <= 99 &&
           d.mo >= 1 && d.mo <= 12 &&
           d.d >= 1 && d.d <= month_days(d.y, d.mo) &&
           d.h < 24 && d.m < 60 && d.s < 60;
}

static void rtc_task(void)
{
    static uint32_t next;

    if (!due(next))
        return;

    next = ms() + 1000;

    uint8_t b[7], s;
    rtc_ok = false;

    if (!rtc_io(false, 0, b, 7) ||
        !rtc_io(false, 15, &s, 1) ||
        (s & 128) ||
        (b[5] & 128))
        return;

    for (unsigned i = 0; i < 7; i++) {
        if (i != 3 && (b[i] & 15) > 9)
            return;
    }

    Date d = {
        dec(b[6]),
        dec(b[5] & 31),
        dec(b[4] & 63),
        0,
        dec(b[1] & 127),
        dec(b[0] & 127)
    };

    if (b[2] & 64) {
        unsigned h = dec(b[2] & 31);

        if (!h || h > 12)
            return;

        d.h = h % 12 + ((b[2] & 32) ? 12 : 0);
    } else {
        d.h = dec(b[2] & 63);
    }

    if (date_valid(d)) {
        date = d;
        rtc_at = ms();
        rtc_ok = true;
    }
}

static bool digits(const char *s, unsigned n)
{
    if (strlen(s) != n)
        return false;

    while (*s) {
        if (*s < '0' || *s > '9')
            return false;

        s++;
    }

    return true;
}

static unsigned pair(const char *s)
{
    return (unsigned)(s[0] - '0') * 10 +
           (unsigned)(s[1] - '0');
}

static bool set_clock(const char *s)
{
    if (!digits(s, 14) || s[0] != '2' || s[1] != '0')
        return false;

    Date d = {
        (uint8_t)pair(s + 2),
        (uint8_t)pair(s + 4),
        (uint8_t)pair(s + 6),
        (uint8_t)pair(s + 8),
        (uint8_t)pair(s + 10),
        (uint8_t)pair(s + 12)
    };

    if (!date_valid(d))
        return false;

    unsigned days = 0;

    for (unsigned y = 0; y < d.y; y++)
        days += 365 + (y % 4 == 0);

    for (unsigned m = 1; m < d.mo; m++)
        days += month_days(d.y, m);

    uint8_t b[] = {
        bcd(d.s),
        bcd(d.m),
        bcd(d.h),
        (uint8_t)((days + d.d + 5) % 7 + 1),
        bcd(d.d),
        bcd(d.mo),
        bcd(d.y)
    };

    uint8_t c, status;

    if (!rtc_io(false, 14, &c, 1) ||
        !rtc_io(false, 15, &status, 1))
        return false;

    c &= 127;
    status &= 127;

    if (!rtc_io(true, 0, b, 7) ||
        !rtc_io(true, 14, &c, 1) ||
        !rtc_io(true, 15, &status, 1))
        return false;

    date = d;
    rtc_at = ms();
    rtc_ok = true;

    return true;
}

/*
 * LCD backpack mapping:
 * RS=P0, RW=P1, E=P2, BL=P3, D4-D7=P4-P7.
 */

static uint8_t lcd_addr, lcd_state;
static char want[4][20], have[4][20];

static bool lcd_nibble(uint8_t n, bool rs)
{
    uint8_t v = (uint8_t)((n << 4) | 8 | rs);
    uint8_t b[] = {v, (uint8_t)(v | 4), v};

    return iwrite(lcd_addr, b, 3);
}

static bool lcd_byte(uint8_t v, bool rs)
{
    uint8_t a = (uint8_t)((v & 240) | 8 | rs);
    uint8_t b = (uint8_t)((v << 4) | 8 | rs);

    uint8_t data[] = {
        a, (uint8_t)(a | 4), a,
        b, (uint8_t)(b | 4), b
    };

    bool ok = iwrite(lcd_addr, data, 6);

    if (ok)
        us(60);

    return ok;
}

static void row(unsigned r, const char *s, bool centre)
{
    unsigned n = (unsigned)strlen(s);

    if (n > 20)
        n = 20;

    memset(want[r], ' ', 20);
    memcpy(want[r] + (centre ? (20 - n) / 2 : 0), s, n);
}

static void display_task(void)
{
    static uint32_t next;
    static uint32_t ip_screen_at;
    static bool ip_screen_started;
    static char startup_ip[16];

    if (!due(next))
        return;
    next = ms() + 100;

    /* Startup display never gates sensors; leave it even without Wi-Fi/LCD. */
    if (!startup_complete && elapsed(boot_at, 16000))
        startup_complete = true;
    if (!startup_started && lcd_state >= 8) {
        startup_started = true;
        startup_at = ms();
    }

    if (startup_started && !startup_complete && !ip_screen_started &&
        elapsed(startup_at, 10000) && ip[0] != '\0' &&
        strcmp(ip, "0.0.0.0") != 0) {
        memcpy(startup_ip, ip, sizeof startup_ip);
        startup_ip[sizeof startup_ip - 1] = '\0';
        ip_screen_started = true;
        ip_screen_at = ms();
    }

    if (ip_screen_started && !startup_complete &&
        elapsed(ip_screen_at, 6000)) {
        startup_complete = true;
    }

    for (unsigned r = 0; r < 4; r++)
        row(r, "", false);

    if (!startup_started || !startup_complete) {
        row(1, "SMART OFFICE", true);
        row(2, "AUTOMATION", true);

        if (ip_screen_started && !elapsed(ip_screen_at, 6000)) {
            char b[32];
            Text t = text(b, sizeof b);
            put(&t, "IP: ");
            put(&t, startup_ip);
            row(3, b, true);
        } else if (ip[0] != '\0' && strcmp(ip, "0.0.0.0") != 0 &&
                   !elapsed(startup_at, 10000)) {
            row(3, "WiFi connected", true);
        } else {
            row(3, "Connecting WiFi...", true);
        }
        return;
    }

    char b[32];
    Text t = text(b, sizeof b);

    if (fire) {
        row(0, "Emergency Door Open", false);
    } else if (pin_len || pin_overflow) {
        put(&t, "Enter PIN: ");
        for (unsigned i = 0; i < pin_len; i++)
            ch(&t, '*');
        if (pin_overflow)
            ch(&t, '!');
        row(0, b, false);
    } else if (message[0] &&
               !elapsed(message_at, granted ? 3000 : 2000)) {
        row(0,
            granted && !elapsed(message_at, 1000)
                ? "Access Granted" : message,
            false);
    } else {
        row(0, hold ? "Door: Held Open" : "Scan RFID/Enter PIN", false);
    }

    row(1,
        fire
            ? ((ms() / 1500) % 2
                   ? "Sprinkler: ON" : "FIRE ALERT: EVACUATE")
            : "No Flame Detected",
        false);

    t = text(b, sizeof b);
    put(&t, "T:");
    if (dht_ok)
        num(&t, temp10 / 10);
    else
        put(&t, "--");
    put(&t, "C H:");
    if (dht_ok)
        num(&t, hum10 / 10);
    else
        put(&t, "--");
    put(&t, "% Fan:");
    put(&t, fan ? "ON" : "OFF");
    row(2, b, false);

    t = text(b, sizeof b);
    put(&t, "Motion: ");
    put(&t, motion_status());
    row(3, b, false);
}
static void lcd_task(void)
{
    static uint32_t next;
    static uint8_t scan, r, c;

    static const uint8_t offsets[] = {
        0, 0x40, 0x14, 0x54
    };

    if (lcd_restart) {
        lcd_restart = false;
        lcd_state = 0;
        r = 0;
        c = 0;

        memset(have, 0, sizeof have);
        next = ms() + 100;
    }

    if (!due(next))
        return;

    next = ms() + 3;

    if (!lcd_state) {
        if (!bus_ready()) {
            next = ms() + 250;
            return;
        }

        lcd_addr = LCD_FIXED_ADDRESS
                 ? LCD_FIXED_ADDRESS
                 : scan == 0 ? 0x27
                 : scan == 1 ? 0x3F
                 : scan < 10 ? 0x20 + scan - 2
                             : 0x38 + scan - 10;

        scan = (scan + 1) % 18;

        if (!bus_result(HAL_I2C_IsDeviceReady(
                &hi2c1, (uint16_t)lcd_addr << 1, 1, 3))) {
            next = ms() + 100;
            return;
        }

        /* Backlight on; E, RW and RS low before initialization. */
        uint8_t idle = 8;

        if (!iwrite(lcd_addr, &idle, 1)) {
            next = ms() + 250;
            return;
        }

        lcd_state = 1;
        next = ms() + 100;
        return;
    }

    bool ok;

    if (lcd_state <= 3) {
        ok = lcd_nibble(3, false);
        next = ms() + 5;

    } else if (lcd_state == 4) {
        ok = lcd_nibble(2, false);

    } else if (lcd_state == 5) {
        ok = lcd_byte(0x28, false);

    } else if (lcd_state == 6) {
        ok = lcd_byte(0x0C, false);

    } else if (lcd_state == 7) {
        ok = lcd_byte(0x06, false) &&
             lcd_byte(1, false);

        memset(have, 0, sizeof have);

    } else {
        ok = true;

        for (unsigned i = 0; i < 80; i++) {
            if (want[r][c] != have[r][c]) {
                char v = want[r][c] ? want[r][c] : ' ';

                ok = lcd_byte(
                         (uint8_t)(0x80 + offsets[r] + c), false) &&
                     lcd_byte((uint8_t)v, true);

                if (ok)
                    have[r][c] = v;

                break;
            }

            if (++c == 20) {
                c = 0;
                r = (r + 1) % 4;
            }
        }
    }

    if (!ok) {
        lcd_state = 0;
        next = ms() + 1000;

    } else if (lcd_state < 8) {
        lcd_state++;
    }
}

/* Keypad */

static void keypad_task(void)
{
    static uint32_t next, changed;
    static char candidate, stable;

    static const uint16_t rows[] = {
        GPIO_PIN_2, GPIO_PIN_3, GPIO_PIN_3, GPIO_PIN_4
    };

    static const uint16_t cols[] = {
        GPIO_PIN_5, GPIO_PIN_12, GPIO_PIN_13, GPIO_PIN_14
    };

    static const char keys[4][4] = {
        {'1', '2', '3', 'A'},
        {'4', '5', '6', 'B'},
        {'7', '8', '9', 'C'},
        {'*', '0', '#', 'D'}
    };

    if ((pin_len || pin_overflow) && elapsed(pin_at, 10000)) {
        pin_len = 0;
        pin_overflow = false;
        pin_value[0] = 0;
    }

    if (!due(next))
        return;

    next = ms() + 10;

    char key = 0;
    unsigned count = 0;

    for (unsigned r = 0; r < 4; r++) {
        GPIO_TypeDef *p = r < 2 ? GPIOA : GPIOB;

        out(p, rows[r], false);
        us(4);

        for (unsigned c = 0; c < 4; c++) {
            if (!high(GPIOB, cols[c])) {
                key = keys[r][c];
                count++;
            }
        }

        out(p, rows[r], true);
    }

    if (count > 1)
        key = 0;

    if (candidate != key) {
        candidate = key;
        changed = ms();
    }

    if (!elapsed(changed, 30) || stable == candidate)
        return;

    stable = candidate;

    if (!stable)
        return;

    pin_at = ms();

    if (stable == '*') {
        pin_len = 0;
        pin_overflow = false;
        pin_value[0] = 0;
        message[0] = 0;

    } else if (stable == '#') {
        uint8_t id = 0;

        if (!pin_overflow && pin_len == 4) {
            id = !strcmp(pin_value, "2026") ? 1
               : !strcmp(pin_value, "2025") ? 2 : 0;
        }

        access(id, 1, 0);

        pin_len = 0;
        pin_overflow = false;
        pin_value[0] = 0;

    } else if (stable >= '0' && stable <= '9') {
        if (pin_len < 4 && !pin_overflow) {
            pin_value[pin_len++] = stable;
            pin_value[pin_len] = 0;
        } else {
            pin_overflow = true;
        }
    }
}

/* Entry RC522 reader */

static bool spi_ok;

static uint8_t rf_reg(uint8_t reg, uint8_t value, bool read)
{
    if (!spi_ok)
        return 0;

    uint8_t tx[] = {
        (uint8_t)(((reg << 1) & 0x7E) | (read ? 128 : 0)),
        value
    };

    uint8_t rx[2] = {0};

    out(GPIOA, RFID_CS, false);

    HAL_StatusTypeDef s =
        HAL_SPI_TransmitReceive(&hspi1, tx, rx, 2, 2);

    out(GPIOA, RFID_CS, true);

    if (s != HAL_OK)
        spi_ok = false;

    return rx[1];
}

static void rw(uint8_t reg, uint8_t v)
{
    (void)rf_reg(reg, v, false);
}

static uint8_t rr(uint8_t reg)
{
    return rf_reg(reg, 0, true);
}

static void rf_start(const uint8_t *b, unsigned n, uint8_t bits)
{
    rw(1, 0);
    rw(4, 127);
    rw(10, 128);

    while (n--)
        rw(9, *b++);

    rw(13, bits);
    rw(1, 12);
    rw(13, bits | 128);
}

static int rf_result(uint8_t *b, unsigned cap)
{
    uint8_t irq = rr(4);

    if (!spi_ok)
        return -1;

    if (!(irq & 0x31))
        return 0;

    rw(13, 0);

    if ((irq & 1) || (rr(6) & 0x1B))
        return -1;

    unsigned n = rr(10);

    if (!n || n > cap || (rr(12) & 7))
        return -1;

    for (unsigned i = 0; i < n; i++)
        b[i] = rr(9);

    return spi_ok ? (int)n : -1;
}

static void rfid_task(void)
{
    static uint8_t stage, miss;
    static bool present;
    static uint32_t next, deadline;

    uint8_t b[10];

    if (stage < 4 && !due(next))
        return;

    if (stage == 0) {
        spi_ok = true;

        out(GPIOA, RFID_CS, true);
        out(GPIOA, RFID_RST, false);

        stage = 1;
        next = ms() + 2;
        return;
    }

    if (stage == 1) {
        out(GPIOA, RFID_RST, true);

        stage = 2;
        next = ms() + 60;
        return;
    }

    if (stage == 2) {
        spi_ok = true;

        uint8_t v = rr(0x37);

        if (!spi_ok || !v || v == 255) {
            stage = 0;
            next = ms() + 3000;
            return;
        }

        rw(0x2A, 0x80);
        rw(0x2B, 0xA9);
        rw(0x2C, 0);
        rw(0x2D, 200);
        rw(0x15, 0x40);
        rw(0x11, 0x3D);
        rw(0x26, 0x70);
        rw(0x14, 0x83);

        if (!spi_ok) {
            stage = 0;
            next = ms() + 3000;
            return;
        }

        stage = 3;
        next = ms() + 10;
        return;
    }

    if (stage == 3) {
        b[0] = 0x52;
        rf_start(b, 1, 7);

        stage = 4;
        deadline = ms() + 15;
        return;
    }

    int n = rf_result(b, sizeof b);

    if (!n && !due(deadline))
        return;

    if (stage == 4 && n == 2) {
        miss = 0;

        if (!present) {
            b[0] = 0x93;
            b[1] = 0x20;
            rf_start(b, 2, 0);

            stage = 5;
            deadline = ms() + 15;
            return;
        }

    } else if (stage == 5 && n == 5 &&
               (uint8_t)(b[0] ^ b[1] ^ b[2] ^ b[3]) == b[4]) {

        uint32_t uid =
            ((uint32_t)b[0] << 24) |
            ((uint32_t)b[1] << 16) |
            ((uint32_t)b[2] << 8) |
            b[3];

        uint8_t id = uid == 0x9A6E3B1DUL ? 1
                   : uid == 0xDA3C441DUL ? 2 : 0;

        if (b[0] == 0x88)
            id = 0;

        access(id, 0, uid);

        present = true;
        miss = 0;

    } else if (stage == 4) {
        if (miss < 3)
            miss++;

        if (miss >= 3)
            present = false;
    }

    rw(1, 0);
    rw(0x14, 0x80);

    if (!spi_ok) {
        out(GPIOA, RFID_RST, false);

        stage = 0;
        next = ms() + 3000;
    } else {
        stage = 2;
        next = ms() + 180;
    }
}

