static uint32_t ms(void)
{
    return HAL_GetTick();
}

static bool due(uint32_t t)
{
    return (int32_t)(ms() - t) >= 0;
}

static bool elapsed(uint32_t t, uint32_t n)
{
    return (uint32_t)(ms() - t) >= n;
}

static bool high(GPIO_TypeDef *p, uint16_t b)
{
    return (p->IDR & b) != 0;
}

static void out(GPIO_TypeDef *p, uint16_t b, bool on)
{
    p->BSRR = on ? (uint32_t)b : (uint32_t)b << 16;
}

static bool flame_input(void)
{
    return FLAME_ACTIVE_LOW
        ? !high(GPIOB, FLAME_PIN)
        : high(GPIOB, FLAME_PIN);
}

static void us(uint16_t n)
{
    uint16_t t = (uint16_t)TIM3->CNT;

    while ((uint16_t)((uint16_t)TIM3->CNT - t) < n) {
    }
}

static void gpio(GPIO_TypeDef *p, uint16_t b,
                 uint32_t mode, uint32_t pull)
{
    GPIO_InitTypeDef g = {0};

    g.Pin = b;
    g.Mode = mode;
    g.Pull = pull;
    g.Speed = GPIO_SPEED_FREQ_HIGH;

    HAL_GPIO_Init(p, &g);
}

/* Small bounded formatter; avoids printf-family code. */

typedef struct {
    char *p;
    unsigned n, cap;
} Text;

static Text text(char *p, unsigned cap)
{
    Text t = {p, 0, cap};

    if (cap)
        p[0] = 0;

    return t;
}

static void ch(Text *t, char c)
{
    if (t->n + 1 < t->cap) {
        t->p[t->n++] = c;
        t->p[t->n] = 0;
    }
}

static void put(Text *t, const char *s)
{
    while (*s)
        ch(t, *s++);
}

static void num(Text *t, uint32_t v)
{
    char b[10];
    unsigned n = 0;

    do {
        b[n++] = (char)('0' + v % 10);
        v /= 10;
    } while (v);

    while (n)
        ch(t, b[--n]);
}

static void two(Text *t, unsigned v)
{
    ch(t, (char)('0' + v / 10 % 10));
    ch(t, (char)('0' + v % 10));
}

static void hex8(Text *t, uint32_t v)
{
    for (int i = 28; i >= 0; i -= 4)
        ch(t, "0123456789ABCDEF"[(v >> i) & 15]);
}

static void quoted(Text *t, const char *s)
{
    ch(t, '"');
    put(t, s);
    ch(t, '"');
}

